load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:config.bzl", "avc_version", "ksp_avc_version_max", "ksp_avc_version_min", "python_version", "version")
load("//service:build.bzl", "service_targets", "service_zip_path_map")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

exports_files([
    ".clang-format",
    ".clang-tidy",
    ".luacheckrc",
    "CHANGELOG.md",
    "COPYING",
    "COPYING.LESSER",
    "KRPC.sln",
    "MODULE.bazel",
    "media/logo-mark.svg",
    "media/logo-on-dark.svg",
    "media/logo-on-light.svg",
    "pyrightconfig.json",
    "ruff.toml",
])

