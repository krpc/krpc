genrule(
    name = "license",
    outs = ["LICENSE"],
    cmd = 'echo "%s" > "$@"' % license_text,
)

genrule(
    name = "readme",
    outs = ["README.txt"],
    cmd = 'echo "%s" > "$@"' % readme_text,
    visibility = ["//visibility:public"],
)

genrule(
    name = "blank_settings",
    outs = ["GameData/kRPC/PluginData/settings.cfg"],
    cmd = 'echo "" > "$@"',
)

genrule(
    name = "version",
    outs = ["VERSION.txt"],
    cmd = 'echo "%s" > "$@"' % version,
    visibility = ["//visibility:public"],
)

genrule(
    name = "python_version",
    outs = ["version.py"],
    cmd = 'echo "__version__ = \\"%s\\"" > "$@"' % python_version,
    visibility = ["//visibility:public"],
)

ksp_avc_version = """{
  "NAME": "kRPC",
  "URL": "http://ksp-avc.cybutek.net/version.php?id=254",
  "DOWNLOAD": "https://github.com/krpc/krpc/releases/latest",
  "VERSION": { %s },
  "KSP_VERSION": { %s },
  "KSP_VERSION_MAX": { %s },
  "KSP_VERSION_MIN": { %s }
}""" % (avc_version, ksp_avc_version_max, ksp_avc_version_max, ksp_avc_version_min)

genrule(
    name = "ksp-avc-version",
    outs = ["kRPC.version"],
    cmd = 'echo \'%s\' > "$@"' % ksp_avc_version,
)

pkg_zip(
    name = "krpc",
    out = "krpc-%s.zip" % version,
    exclude = ["*.mdb"],
    files = [
        ":readme",
        ":license",
        ":version",
        ":ksp-avc-version",
        "COPYING",
        "COPYING.LESSER",
        # Server
        "//core",
        "//server",
        ":blank_settings",
        "//tools/build/ksp:Google.Protobuf.dll",
        "//tools/build/protobuf:LICENSE.Google.Protobuf",
        "//tools/build/ksp:KRPC.IO.Ports.dll",
        "@csharp_krpc_io_ports_license//file",
        # Module Manager
        "@module_manager//file",
        # Schema
        "//protobuf:krpc.proto",
        "//protobuf:LICENSE",
    ] + service_targets(),
    path_map = service_zip_path_map() | {
        "kRPC.version": "GameData/kRPC/kRPC.version",
        # Server
        "core/KRPC.Core.net472/net472/": "GameData/kRPC/",
        "core/": "GameData/kRPC/",
        "server/KRPC/net472/": "GameData/kRPC/",
        "server/": "GameData/kRPC/",
        "server/src/icons": "GameData/kRPC/icons",
        "tools/build/ksp/": "GameData/kRPC/",
        "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.Google.Protobuf",
        "../+http_file+csharp_krpc_io_ports_license/file/LICENSE.KRPC.IO.Ports": "LICENSE.KRPC.IO.Ports",
        # Services, beside the paths of service_zip_path_map
        "service/SpaceCenter/src/module-manager.cfg": "GameData/kRPC/module-manager.cfg",
        # Module Manager
        "../+http_file+module_manager/file/ModuleManager.4.2.3.dll": "GameData/ModuleManager.4.2.3.dll",
        # Schema
        "protobuf/": "schema/",
    },
)

# Formatting and lint of the Bazel files, across the whole source tree. The test
# reads the tree in place, so it runs unsandboxed and is never cached.
py_test(
    name = "buildifier",
    size = "small",
    srcs = ["//tools/build:run_buildifier.py"],
    args = [
        "--buildifier=$(rlocationpath @buildifier_prebuilt//:buildifier)",
        "--workspace=$(rlocationpath MODULE.bazel)",
    ],
    data = [
        "MODULE.bazel",
        "@buildifier_prebuilt//:buildifier",
    ],
    main = "run_buildifier.py",
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# The Bazel build globs its C# sources, so it cannot see a source file that is
# missing from a .csproj -- only a `dotnet build` of KRPC.sln can. This checks the
# .csproj file lists directly, so the divergence is caught without a .NET SDK.
py_test(
    name = "csproj-test",
    srcs = ["//tools/build:csproj_test.py"],
    data = [
        "KRPC.sln",
        "//client/csharp:csproj-srcs",
        "//core:csproj-srcs",
        "//server:csproj-srcs",
        "//tools/ServiceDefinitions:csproj-srcs",
        "//tools/TestServer:csproj-srcs",
        "//tools/TestingTools:csproj-srcs",
        "//tools/benchmarks:csproj-srcs",
    ] + service_targets("csproj-srcs"),
    main = "csproj_test.py",
)

test_suite(
    name = "test",
    tests = [
        "//:buildifier",
        "//:changelog-fragments-test",
        "//:changelog-test",
        "//:csproj-test",
        "//:pyright-release",
        "//:ruff-release",
        "//client/cnano:test",
        "//client/conformance:test",
        "//client/cpp:test",
        "//client/csharp:test",
        "//client/java:test",
        "//client/lua:test",
        "//client/python:test",
        "//client/websockets:test",
        "//core:test",
        "//doc:test",
        "//service:test",
        "//tools/benchmarks:test",
        "//tools/build:test",
        "//tools/ci:test",
        "//tools/game:test",
        "//tools/krpctools:test",
    ] + service_targets("test"),
)

filegroup(
    name = "csproj",
    testonly = True,
    srcs = [
        "//client/csharp:KRPC.Client",
        "//client/csharp:test-KRPC.Client",
        "//core",
        "//core:test-KRPC.Core",
        "//server",
        "//tools/ServiceDefinitions",
        "//tools/TestServer",
        "//tools/TestingTools",
        "//tools/benchmarks:KRPC.Benchmark.net472",
        "//tools/build/ksp:Google.Protobuf.dll",
        "//tools/build/ksp:KRPC.IO.Ports.dll",
    ] + service_targets(),
)

# The changelog parser and fragment merge, shared by the docs changelog page and
# the release scripts
py_library(
    name = "changelog",
    srcs = ["tools/release/changelog.py"],
    imports = ["tools/release"],
    visibility = ["//visibility:public"],
)

# The unreleased changelog entries, one file per pull request. Absent after a
# release, until the next fragment is added.
filegroup(
    name = "changelog-fragments",
    srcs = glob(
        ["changelog.d/**"],
        allow_empty = True,
    ),
    visibility = ["//doc:__pkg__"],
)

py_test(
    name = "changelog-test",
    size = "small",
    srcs = ["tools/release/changelog_test.py"],
    main = "tools/release/changelog_test.py",
    deps = [":changelog"],
)

py_test(
    name = "changelog-fragments-test",
    size = "small",
    srcs = ["tools/release/check_fragments.py"],
    data = [":changelog-fragments"],
    main = "tools/release/check_fragments.py",
    deps = [":changelog"],
)

py_ruff_test(
    name = "ruff-release",
    size = "small",
    srcs = glob(["tools/release/*.py"]),
)

py_pyright_test(
    name = "pyright-release",
    size = "medium",
    srcs = glob(["tools/release/*.py"]),
    python_version = "3.12",
)
