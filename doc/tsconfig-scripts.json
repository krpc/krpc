{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "types": [],
    "strict": true,
    // The examples leave out null checks for brevity
    "strictNullChecks": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@krpc-org/krpc": ["../client/js/dist/index.d.ts"]
    }
  },
  "include": [
    "src/scripts/js/*.js",
    "src/scripts/api/**/*.js",
    "src/scripts/user-guide/**/*.js"
  ]
}
