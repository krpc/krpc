# Release builds carry a plain "x.y.z" version; CI stamps dev builds with a
# "-<build>-<sha>" suffix (the build-setup action's version step). A dev build is
# published under /dev/ and stamped "dev" so the theme's version switcher and
# old-version warning banner flag it as unreleased; a release publishes under
# /<version>/ stamped with its number. Deriving the channel from the version
# string keeps the docs in step with the version everything else builds with.
docs_version = "dev" if "-" in version else version

genrule(
    name = "conf",
    srcs = ["conf.py.tmpl"],
    outs = ["src/conf.py"],
    # %VERSION%/%SUBPATH% get the channel ('dev' or the release number).
    # %FULL_VERSION% gets the untruncated config.bzl version (the client
    # artifacts' version), for examples that name a built jar. The commit sha is deliberately not
    # substituted in: it reaches a dev build's footer at page-load time via
    # build-info.json, keeping the HTML identical from one commit to the next.
    cmd = "sed -e 's/%VERSION%/" + docs_version + "/g' -e 's/%SUBPATH%/" + docs_version + "/g' -e 's/%FULL_VERSION%/" + version + "/g' \"$<\" > \"$@\"",
)

sphinx_build(
    name = "html",
    srcs = [":srcs"],
    out = "html.zip",
    builder = "html",
    # Stamp -Dversion to match conf.py's version, so DOCUMENTATION_OPTIONS.VERSION
    # is "dev" for a dev build and the release number otherwise.
    opts = {"version": docs_version},
    sphinx_build = ":sphinx-build",
    # The dot graphs are drawn by graphviz, which is a system install rather than
    # something the build fetches, and only the Linux image carries it.
    target_compatible_with = ["@platforms//os:linux"],
)

sphinx_build(
    name = "pdf",
    srcs = [":srcs"],
    out = "krpc-doc-%s.pdf" % version,
    builder = "latex",
    opts = {"version": version},
    sphinx_build = ":sphinx-build",
    # The latex->pdf step needs `make` and a LaTeX toolchain (texlive).
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//:__pkg__"],
)

