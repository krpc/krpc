# Type-check the Python example scripts against the typed client generated from
# this tree, so the examples cannot silently drift from the API. The C, C++, C#
# and Java examples are compile-checked by :compile-scripts, and :luacheck lints
# the Lua ones. The JavaScript examples and BasicArduino.ino have no automated
# check, as the build has no toolchain for them.
py_test(
    name = "check-scripts-pyright",
    size = "medium",
    srcs = ["check_scripts_pyright.py"],
    data = glob(["src/scripts/**/*.py"]) + ["//:pyrightconfig.json"],
    # Generated __init__.py files would make the scripts directories packages
    legacy_create_init = False,
    main = "check_scripts_pyright.py",
    deps = [
        "//client/python:krpc_lib",
        "@krpc_pypi//basedpyright",
    ],
)

sphinx_spelling_test(
