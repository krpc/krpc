load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")
load("//tools/doc_examples:defs.bzl", "example_js_runner")

# The in-game tests of the documentation examples. The game runs them with
# bazel run //tools/game:test-ksp -- doc/test

test_suite(
    name = "test",
    tests = [
        ":coverage",
        ":pyright",
        ":ruff",
    ],
    visibility = ["//doc:__pkg__"],
)

# What the coverage test reads: the manifest, its types and the listings
py_library(
    name = "manifest",
    srcs = [
        "checks.py",
        "examples.py",
        "flights.py",
        "spec.py",
    ],
    data = ["unsupported.txt"],
    imports = ["../.."],
    deps = ["//tools/doc_examples"],
)

py_test(
    name = "coverage",
    size = "small",
    srcs = ["coverage_test.py"],
    data = ["//doc:scripts"],
    main = "coverage_test.py",
    deps = [":manifest"],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    # The tests do not check for None results
    disable = ["reportOptionalMemberAccess"],
    deps = [
        "//client/python:krpc_lib",
        "//tools/doc_examples",
        "//tools/krpctools:krpctools_lib",
        "@krpc_pypi//pytest",
    ],
)

# Opens the C-nano examples' serial connection over TCP/IP, for //doc:run-scripts-cnano
cc_library(
    name = "cnano_redirect",
    testonly = True,
    srcs = ["cnano_redirect.c"],
    visibility = ["//doc:__pkg__"],
    deps = ["//client/cnano:krpc_cnano_print_errors"],
)

# Runs a JavaScript example against the game's WebSockets server
example_js_runner(
    name = "run-example-js",
    data = ["//doc:scripts-js"],
    scripts = "doc/src/scripts",
)
