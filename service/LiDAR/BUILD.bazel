load("//:config.bzl", "assembly_version", "author")
load("//service:build.bzl", "registry_entry", "service_deps", "service_info", "service_libraries")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:csharp.bzl", "csharp_library")
load("//tools/ServiceDefinitions:build.bzl", "service_definitions")

service = registry_entry("LiDAR")

exports_files(["CHANGELOG.md"])

filegroup(
    name = "LiDAR",
    srcs = [
        "CHANGELOG.md",
        ":KRPC.LiDAR",
        ":ServiceDefinitions",
    ],
    visibility = ["//:__pkg__"],
)

csharp_assembly_info(
    name = "AssemblyInfo",
    cls_compliant = False,
    copyright = author,
    description = service.description,
    title = "KRPC.LiDAR",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to //:csproj-deps so it can copy AssemblyInfo.cs to generated_deps
    ],
)

service_info(
    name = "ServiceInfo",
    namespace = "KRPC.LiDAR",
    service = service,
)

srcs = [
    ":AssemblyInfo",
    ":ServiceInfo",
] + glob(["src/**/*.cs"])

deps = service_deps + service_libraries(service.deps)

csharp_library(
    name = "KRPC.LiDAR",
    srcs = srcs,
    target_frameworks = ["net472"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = deps,
)

service_definitions(
    name = "ServiceDefinitions",
    out = "KRPC.LiDAR.json",
    assemblies = [":KRPC.LiDAR"] + service_libraries(service.deps) + ["//server:KRPC"],
    service = service.name,
    visibility = ["//visibility:public"],
)

# Sources for //:csproj-test, which checks them against the .csproj file lists.
filegroup(
    name = "csproj-srcs",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
    ]),
    visibility = [
        "//:__pkg__",
        "//service:__pkg__",
    ],
)

# The service has no tests
test_suite(
    name = "test",
    tests = [],
)
