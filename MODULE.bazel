module(name = "krpc")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "protobuf", version = "36.2")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# Newer than the abseil protobuf asks for, as its headers use attribute spellings
# that clang 23 does not deprecate
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "rules_dotnet", version = "0.22.2")

# Skip the _._ placeholder files in a NuGet package's native folders. The runtime.*.System.IO.Ports
# packages each hold one per RID, and the copies collide when a binary links them.
single_version_override(
    module_name = "rules_dotnet",
    patch_strip = 1,
    patches = ["//tools/build/dotnet/patches:rules_dotnet-native-placeholder.patch"],
)

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.400")
use_repo(dotnet, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

# LLVM toolchain for the C/C++ clients (compiler + clang-format/clang-tidy). Two
# variants: a hermetic download (the default, used on dev) and a system install
# (used in CI via `--config=system-llvm`, which avoids the ~2 GB download). Switch
# with `--//tools/build/llvm:toolchain=system` (see .bazelrc + tools/build/llvm).
bazel_dep(name = "toolchains_llvm", version = "1.12.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

# Hermetic (downloads the LLVM release) -- registered as the default toolchain.
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "23.1.3",
)

# System (no download; toolchains_llvm resolves clang from an existing install).
# The path is the apt.llvm.org clang-23 layout baked into the buildenv image; it
# only exists inside the container, and is only used when `--config=system-llvm`
# opts in via --extra_toolchains, so dev checkouts are unaffected.
llvm.toolchain(
    name = "llvm_system",
    llvm_version = "23.1.3",
)
llvm.toolchain_root(
    name = "llvm_system",
    path = "/usr/lib/llvm-23",
)

# Path-mode generates only the config repo (@llvm_system); there is no downloaded
# @llvm_system_llvm binaries repo, so the clang-tidy/clang-format labels for system
# mode come from wrapper scripts in //tools/build/llvm, not from here.
use_repo(llvm, "llvm_system", "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains("@llvm_toolchain//:all")

# clang-format for the lint rules on Windows, where toolchains_llvm downloads no
# toolchain and so declares no LLVM tools. This is the binary from the same LLVM
# release, packaged as a python wheel (a zip) by the clang-format project. Keep
# the version in step with llvm_version above, so a source formatted on one
# platform is formatted on the other.
http_archive(
    name = "clang_format_windows",
    build_file_content = "exports_files(['clang_format/data/bin/clang-format.exe'])",
    sha256 = "6c2b74c3a3e942ec172d768e7b945f8e136db05a7b735d49ecfc69bda97643ad",
    type = "zip",
    url = "https://files.pythonhosted.org/packages/23/a6/90148f91544e3c056e78c514f0e764c1b44d50a33344c83fd03011ea97c8/clang_format-23.1.3-py2.py3-none-win_amd64.whl",
)

