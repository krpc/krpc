load("@rules_dotnet//dotnet:defs.bzl", "publish_binary")
load("//:config.bzl", "assembly_version", "author")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:csharp.bzl", "csharp_binary")

csharp_binary(
    name = "ServiceDefinitions",
    srcs = glob(["**/*.cs"]) + [
        ":AssemblyInfo",
        "//tools/CommandLine:ToolCommandLine.cs",
    ],
    nowarn = [
        "CS1591",
        "CS1701",
    ],
    target_frameworks = ["net10.0"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = [
        "//core:KRPC.Core.net10",
        "@paket.main//system.commandline",
    ],
)

# Framework-dependent layout of the tool, bundled into the krpctools python package. It runs
# with `dotnet ServiceDefinitions.dll` on any platform, as it never loads System.IO.Ports, the
# one part specific to the RID.
publish_binary(
    name = "publish",
    binary = ":ServiceDefinitions",
    runtime_identifier = "linux-x64",
    self_contained = False,
    target_framework = "net10.0",
    visibility = ["//tools/krpctools:__pkg__"],
)

csharp_assembly_info(
    name = "AssemblyInfo",
    copyright = author,
    title = "ServiceDefinitions",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to //:csproj-deps so it can copy AssemblyInfo.cs to generated_deps
    ],
)

# Sources for //:csproj-test, which checks them against the .csproj file lists.
filegroup(
    name = "csproj-srcs",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
    ]),
    visibility = ["//:__pkg__"],
)
