load("@rules_dotnet//dotnet:defs.bzl", "publish_binary")
load("//:config.bzl", "assembly_version", "author")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:csharp.bzl", "csharp_binary", "csharp_library")
load("//tools/ServiceDefinitions:build.bzl", "service_definitions")
load(":rids.bzl", "RIDS")

csharp_assembly_info(
    name = "AssemblyInfo",
    cls_compliant = False,
    copyright = author,
    title = "TestServer",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to //:csproj-deps so it can copy AssemblyInfo.cs to generated_deps
    ],
)

srcs = [
    "src/ConformanceService.cs",
    "src/TestService.cs",
    ":AssemblyInfo",
]

# The extension members, and the service whose class one of them returns, are built into
# the server but not into the assembly the service definitions are generated from. The
# bundled stubs therefore lack them, and a client has to pick them up from the definitions
# the server sends at connect
exe_srcs = srcs + [
    "src/Program.cs",
    "src/TestService2.cs",
    "src/TestServiceExtensions.cs",
]

exe_deps = [
    "//core:KRPC.Core.net10",
    # The benchmark service, which the server exposes alongside TestService
    "//tools/benchmarks:KRPC.Benchmark.net10",
    "//tools/build/dotnet:Google.Protobuf",
    "//tools/build/dotnet:System.IO.Ports",
    "//tools/build/dotnet:NDesk.Options",
]

csharp_binary(
    name = "TestServer",
    srcs = exe_srcs,
    nowarn = [
        "CS1591",
        "CS1701",
    ],
    target_frameworks = ["net10.0"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = exe_deps,
)

# The server reads API documentation from the XML doc file next to each
# assembly at runtime, so krpctools ships it beside the binaries.
genrule(
    name = "TestServer-xmldoc",
    srcs = [":TestServer"],
    outs = ["xmldoc/TestServer.xml"],
    cmd = 'for f in $(SRCS); do case "$$f" in *.xml) cp "$$f" "$@";; esac; done',
    visibility = ["//tools/krpctools:__pkg__"],
)

# Framework-dependent layouts of TestServer for krpctools, one per RID, as serial IO needs the
# System.IO.Ports build for the platform. Each runs with `dotnet TestServer.dll`.
[
    publish_binary(
        name = "publish-" + rid,
        binary = ":TestServer",
        runtime_identifier = rid,
        self_contained = False,
        target_framework = "net10.0",
        visibility = ["//tools/krpctools:__pkg__"],
    )
    for rid in RIDS
]

csharp_library(
    name = "TestService",
    srcs = srcs,
    nowarn = [
        "CS1591",
        "CS1701",
    ],
    target_frameworks = ["net10.0"],
    treat_warnings_as_errors = True,
    warning_level = 4,
    deps = [
        "//core:KRPC.Core.net10",
        "//tools/build/dotnet:Google.Protobuf",
    ],
)

service_definitions(
    name = "ServiceDefinitions",
    out = "TestService.json",
    assemblies = [":TestService"],
    service = "TestService",
    visibility = ["//visibility:public"],
)

service_definitions(
    name = "ConformanceServiceDefinitions",
    out = "ConformanceService.json",
    assemblies = [":TestService"],
    service = "ConformanceService",
    visibility = ["//visibility:public"],
)

# Sources for //:csproj-test, which checks them against the .csproj file lists.
filegroup(
    name = "csproj-srcs",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
    ]),
    visibility = ["//:__pkg__"],
)
