load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

py_library(
    name = "deps",
    srcs = ["deps.py"],
    imports = ["."],
)

py_test(
    name = "deps-test",
    size = "small",
    srcs = ["deps_test.py"],
    imports = ["."],
    main = "deps_test.py",
    deps = [":deps"],
)

# Checks the pins of the whole source tree against deps.toml. It reads the tree in place,
# through the runfiles symlink of deps.py, so it runs every time.
py_test(
    name = "deps-check",
    size = "small",
    srcs = ["deps.py"],
    args = ["check"],
    main = "deps.py",
    tags = ["external"],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    python_version = "3.12",
)

test_suite(
    name = "test",
    tests = [
        ":deps-check",
        ":deps-test",
        ":pyright",
        ":ruff",
    ],
)
