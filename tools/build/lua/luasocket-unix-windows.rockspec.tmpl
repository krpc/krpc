-- Generated by //tools/build/lua from this template and the patch beside it. The rock
-- tracks luasocket rather than kRPC, so it is published once per luasocket it is built
-- from rather than with a kRPC release:
--
--   bazel build //tools/build/lua:luasocket-unix-windows-rockspec
--   luarocks upload bazel-bin/tools/build/lua/luasocket-unix-windows-%VERSION%-1.rockspec
--
-- Retire it once a luasocket release builds socket.unix on Windows itself.
rockspec_format = "3.0"
package = "luasocket-unix-windows"
version = "%VERSION%-1"
source = {
  url = "https://github.com/lunarmodules/luasocket/archive/refs/tags/v%VERSION%.tar.gz",
  dir = "luasocket-%VERSION%"
}
description = {
  summary = "LuaSocket's socket.unix module, built for Windows",
  detailed = [[
Windows has carried unix domain sockets since Windows 10, but LuaSocket builds its
socket.unix module only on unix, macOS and Haiku. This rock builds that one module
from the LuaSocket sources so that require 'socket.unix' works on Windows too, and
installs nothing else: LuaSocket itself provides the rest.

Note that Windows implements the stream sockets only, so socket.unix.dgram reports
an unsupported address family in place of returning a socket.

This rock is a stopgap published by the kRPC project, not by LuaSocket, and the
change it applies is offered upstream. Remove it once a LuaSocket release builds
socket.unix on Windows itself: both would own socket/unix.dll, which LuaRocks
reports as a conflict rather than choosing between. Report problems with it to the
issue tracker below rather than to LuaSocket, which did not build it.

Built from LuaSocket: https://github.com/lunarmodules/luasocket]],
  homepage = "https://krpc.github.io/krpc",
  issues_url = "https://github.com/krpc/krpc/issues",
  license = "MIT"
}
-- Everywhere else LuaSocket ships the module itself, and two rocks installing the
-- same one would be a conflict rather than a choice.
supported_platforms = { "windows" }
dependencies = {
  "lua >= 5.1"
}

-- The module as the LuaSocket rockspec builds it on unix, with the Winsock socket
-- layer in place of the POSIX one and inet.c for the inet_aton that options.c calls.
local function make_plat(plat)
  local defines = {
    win32 = { "LUASOCKET_DEBUG", "NDEBUG" },
    mingw32 = { "LUASOCKET_DEBUG", "WINVER=0x0501" }
  }
  return {
    modules = {
      ["socket.unix"] = {
        sources = {
          "src/buffer.c"
          , "src/compat.c"
          , "src/auxiliar.c"
          , "src/options.c"
          , "src/timeout.c"
          , "src/io.c"
          , "src/inet.c"
          , "src/wsocket.c"
          , "src/unix.c"
          , "src/unixdgram.c"
          , "src/unixstream.c" },
        defines = defines[plat],
        libraries = { "ws2_32" },
        incdir = "/src"
      }
    }
  }
end

build = {
  type = "builtin",
  patches = {
    ["windows-af-unix.patch"] = [==[
%PATCH%]==]
  },
  platforms = {
    win32 = make_plat("win32"),
    mingw32 = make_plat("mingw32")
  }
}
