load("@rules_dotnet//dotnet:defs.bzl", "import_dll", "import_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

package(default_visibility = ["//visibility:public"])

# The NuGet packages are the targets of @paket.main, for example @paket.main//google.protobuf.
# They are listed in paket.dependencies. The mod itself uses the assets in //tools/build/ksp,
# which are pinned to versions compatible with KSP's version of Unity.

exports_files(["analyzers.globalconfig"])

# Google.Protobuf for the netstandard2.0 client library. It compiles against the
# netstandard2.0 asset, with the System.Memory and Unsafe references that asset
# needs. It runs on the net8.0 asset, the one NuGet gives a .NET 10 program.
# The target framework of a @paket.main target applies to both compiling and running.
import_library(
    name = "Google.Protobuf.netstandard2.0",
    library_name = "Google.Protobuf",
    libs = ["@nuget.google.protobuf.v3.36.2//:lib/net8.0/Google.Protobuf.dll"],
    refs = [
        "@nuget.google.protobuf.v3.36.2//:lib/netstandard2.0/Google.Protobuf.dll",
        "@nuget.system.memory.v4.5.3//:lib/netstandard2.0/System.Memory.dll",
        "@nuget.system.runtime.compilerservices.unsafe.v4.5.2//:lib/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll",
    ],
    version = "3.36.2",
)

import_dll(
    name = "NDesk.Options",
    dll = "@csharp_options//:lib/NDesk.Options.dll",
)

# Run after editing paket.dependencies, to regenerate paket.lock and the paket.*.bzl files
py_binary(
    name = "update",
    srcs = ["update.py"],
    args = [
        "--paket=$(rlocationpath @paket.tools//paket/tools:paket)",
        "--paket2bazel=$(rlocationpath @rules_dotnet//tools/paket2bazel)",
    ],
    data = [
        "@paket.tools//paket/tools:paket",
        "@rules_dotnet//tools/paket2bazel",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# Checks the NuGet versions written by hand against paket.lock, as a stale version in an
# import_library or a nuget_package still builds
py_test(
    name = "versions-test",
    size = "small",
    srcs = ["check_versions.py"],
    args = [
        "$(rootpath paket.main.bzl)",
        "$(rootpath BUILD.bazel)",
        "$(rootpath //:MODULE.bazel)",
        "$(rootpath //client/csharp:BUILD.bazel)",
    ],
    data = [
        "BUILD.bazel",
        "paket.main.bzl",
        "//:MODULE.bazel",
        "//client/csharp:BUILD.bazel",
    ],
    main = "check_versions.py",
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = [
        "check_versions.py",
        "update.py",
    ],
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = [
        "check_versions.py",
        "update.py",
    ],
    python_version = "3.12",
    deps = ["@rules_python//python/runfiles"],
)
