# Analyzer rules for every C# build, from Bazel and from the project files.
#
# These guard against the ambient culture leaking into values that leave the
# process. kRPC runs on the player's machine, so the culture follows their
# operating system. A decimal comma breaks number parsing in every client, and
# Turkish case folding maps i onto a dotted capital I.

is_global = true

# Every analyzer rule is off unless named below
dotnet_analyzer_diagnostic.severity = none

# Specify CultureInfo / IFormatProvider
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
# Specify StringComparison for correctness
dotnet_diagnostic.CA1310.severity = error
# Use ToUpperInvariant / ToLowerInvariant
dotnet_diagnostic.CA1311.severity = error
