+def _host_native_package(rctx):
+    """The native package of the host, such as typescript-linux-x64, the one tsc runs."""
+    os = rctx.os.name.lower()
+    if os.startswith("mac"):
+        os = "darwin"
+    elif os.startswith("windows"):
+        os = "win32"
+    arch = {"aarch64": "arm64", "amd64": "x64", "x86_64": "x64"}.get(rctx.os.arch, rctx.os.arch)
+    return "typescript-{}-{}".format(os, arch)
