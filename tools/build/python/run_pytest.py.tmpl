"""Extracts a python wheel and runs pytest on the package within it.

Template instantiated by the py_test macro in //tools/build:python.bzl, which
substitutes the wheel path and which test files to run. The parameters are baked
in rather than passed as arguments, as the test may be invoked via the
client_test harness which does not forward arguments.

Dependencies of the package under test must be provided as deps of the
py_test target so they are already importable.
"""

import os
import sys
import zipfile

import pytest


def main() -> int:
    wheel = "@WHEEL@"
    tests = "@TESTS@".split()
    extract_dir = os.path.join(os.environ.get("TEST_TMPDIR", "."), "wheel")
    with zipfile.ZipFile(wheel) as archive:
        archive.extractall(extract_dir)
    # Make the package under test importable
    sys.path.insert(0, extract_dir)
    # Which tests to run, named relative to the root of the wheel. Naming none of
    # them runs everything the wheel holds.
    targets = [os.path.join(extract_dir, test) for test in tests] or [extract_dir]
    for target in targets:
        if not os.path.exists(target):
            raise SystemExit("no such test: %s" % target)
    # Name an empty config file, which also makes the extracted wheel pytest's
    # rootdir. Bazel extracts the wheel inside the execroot, so left to search for
    # one pytest settles on the repository root:
    # it would apply //pytest.ini, which configures the integration tests, and
    # root collection at the execroot, where Bazel creates and deletes scratch
    # directories while other actions run.
    config = os.path.join(extract_dir, "pytest.ini")
    with open(config, "w", encoding="utf-8"):
        pass
    return pytest.main(["--import-mode=importlib", "-c", config] + targets)


if __name__ == "__main__":
    sys.exit(main())
