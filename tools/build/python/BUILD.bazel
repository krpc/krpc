load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "run_pytest.py.tmpl",
    "run_pyright.py",
    "run_ruff.py",
])

py_binary(
    name = "build_sdist",
    srcs = ["build_sdist.py"],
)

py_console_script_binary(
    name = "hatchling",
    pkg = "@pypi//hatchling",
)

# Produces a :requirements.update run target that resolves requirements.in
# into requirements_lock.txt, and a :requirements_test diff test that checks
# the lock file is up to date.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
    tags = ["requires-network"],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    python_version = "3.12",
)
