# Direct python dependencies of the build.
#
# Runtime dependencies of the python packages, build/test tooling, and the
# sphinx documentation toolchain. Transitive dependencies are resolved into
# requirements_lock.txt; regenerate it with:
#
#   bazel run //tools/build/python:requirements.update

# Runtime dependencies
jinja2==3.1.6
protobuf==7.36.2
pyserial==3.5
requests==2.34.2
websocket-client==1.9.2

# Build and test tooling
basedpyright==1.40.2
cogapp==3.6.0
hatchling
pytest
ruff==0.17.0

# Rasterizing the SVG icons and diagrams. pyvips-binary carries libvips and the
# librsvg that renders them, as wheels for every platform the build runs on, so
# no system install is involved.
pyvips==3.2.0
pyvips-binary==8.18.7

# Sphinx and extensions for the documentation
pydata-sphinx-theme==0.23.0
pyenchant==3.3.0
sphinx==9.1.0
sphinx-csharp==1.0.0
sphinx-tabs==3.5.0
sphinxcontrib-luadomain==1.2.0
sphinxcontrib-spelling==8.0.2

# Live-serving the documentation website (bazel run //doc:serve)
sphinx-autobuild
watchdog

# Java API docs, generated by javasphinx. Upstream javasphinx and its javalang dependency are
# unmaintained, so these point at the project's own builds hosted on the kRPC S3 bucket rather
# than at the PyPI releases.
javalang @ https://krpc.s3.amazonaws.com/lib/javasphinx/javalang-0.13.1.tar.gz
javasphinx @ https://krpc.s3.amazonaws.com/lib/javasphinx/javasphinx-0.9.16.tar.gz
