load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

# The game the repository's in-game tests run against: KSP, with kRPC built from the sources
py_library(
    name = "bazel_ksp",
    srcs = ["bazel_ksp.py"],
    imports = ["."],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [
        "//client/python:krpc_lib",
        "//tools/krpctools:krpctools_lib",
    ],
)

# The tests that need the game, which //:test does not cover. Per game, test-<game> runs
# them and run-<game> runs the game on its own, to test against without a restart.

# Run the tests against KSP: `bazel run //tools/game:test-ksp -- [pytest args]`. The tests
# are read from the repository, as the runner works there, so adding or editing one needs no
# change here.
py_binary(
    name = "test-ksp",
    srcs = ["run_tests.py"],
    main = "run_tests.py",
    visibility = ["//visibility:public"],
    deps = [
        ":bazel_ksp",
        "@krpc_pypi//pytest",
    ],
)

# Install the mod and run KSP: `bazel run //tools/game:run-ksp -- [--mods=... --load-*=...]`.
# This is `krpc-game run` against BazelKSP.
py_binary(
    name = "run-ksp",
    srcs = ["run_ksp.py"],
    main = "run_ksp.py",
    visibility = ["//visibility:public"],
    deps = [":bazel_ksp"],
)

test_suite(
    name = "test",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    deps = [
        ":bazel_ksp",
        "@krpc_pypi//pytest",
    ],
)
