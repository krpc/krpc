# Third-party KSP mods wrapped by kRPC services, used by the integration tests.
#
# These are NOT part of the kRPC release. `krpc-install --mods=...` installs a
# requested subset into the KSP GameData directory so the RemoteTech / InfernalRobotics /
# KerbalAlarmClock service tests can exercise the real mods. Building a target here fetches
# the corresponding archive (declared in MODULE.bazel); krpctest.install then copies the
# mod's GameData subtree from the external repo.
#
# The mod name accepted by `--mods` maps to the GameData folder(s) it installs as follows:
#   RemoteTech        -> GameData/RemoteTech
#   InfernalRobotics  -> GameData/MagicSmokeIndustries
#   KerbalAlarmClock  -> GameData/TriggerTech
#   RealChute         -> GameData/RealChute
#                        + GameData/000_Harmony, GameData/000_ClickThroughBlocker,
#                          GameData/001_ToolbarControl (deps)
#   DMagic            -> GameData/DMagicScienceAnimate
#   AGExt             -> GameData/Diazo
#                        + GameData/000_Harmony, GameData/000_ClickThroughBlocker,
#                          GameData/001_ToolbarControl (deps, shared with RealChute),
#                          GameData/SpaceTuxLibrary (dep)
#   FAR               -> GameData/FerramAerospaceResearch
#                        + GameData/ModularFlightIntegrator, GameData/000_KSPBurst (deps),
#                          GameData/000_Harmony (dep, shared with RealChute and AGExt)
#   RealFuels         -> GameData/RealFuels, GameData/RealFuels-Stock
#                        + GameData/SolverEngines, GameData/ROUtils,
#                          GameData/CommunityResourcePack, GameData/KSPCommunityFixes (deps),
#                          GameData/000_Harmony (dep, shared with RealChute, AGExt and FAR)
# tools/krpctest mirrors this registry on the Python side.

filegroup(
    name = "remotetech",
    srcs = ["@remotetech//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "infernal_robotics",
    srcs = ["@infernal_robotics//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "kerbal_alarm_clock",
    srcs = ["@kerbal_alarm_clock//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "realchute",
    srcs = ["@realchute//:gamedata"],
    visibility = ["//visibility:public"],
)

# Runtime dependencies shared by RealChute and AGExt. Installed only alongside a mod that needs
# them (their plugins will not load without ClickThroughBlocker + ToolbarControl, and
# ClickThroughBlocker references Harmony), never requested on their own.
filegroup(
    name = "harmony",
    srcs = ["@harmony//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "clickthroughblocker",
    srcs = ["@clickthroughblocker//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "toolbarcontrol",
    srcs = ["@toolbarcontrol//:gamedata"],
    visibility = ["//visibility:public"],
)

# DMagic's DMModuleScienceAnimateGeneric part module. Adds no parts of its own; a test-only part
# config (tools/mods/config/DMagicScienceAnimate) supplies a part that uses it. No dependencies.
filegroup(
    name = "dmagic_science_animate",
    srcs = ["@dmagic_science_animate//:gamedata"],
    visibility = ["//visibility:public"],
)

# Action Groups Extended. Adds no parts; a ModuleManager patch adds a ModuleAGX module to every
# part instead. Shares RealChute's ClickThroughBlocker/ToolbarControl/Harmony dependencies, plus
# SpaceTuxLibrary (KSP_Log).
filegroup(
    name = "agext",
    srcs = ["@agext//:gamedata"],
    visibility = ["//visibility:public"],
)

# Ferram Aerospace Research. Installing it swaps the game's aerodynamics model, so it is only
# ever requested by the tests that check the Flight class against FAR.
filegroup(
    name = "far",
    srcs = ["@far//:gamedata"],
    visibility = ["//visibility:public"],
)

# FAR's dependencies, installed alongside it and never requested on their own. KSP refuses to
# load FAR's assembly without ModularFlightIntegrator, and FAR's own types fail to load
# without the Unity job-system assemblies in KSPBurst (which in turn needs Harmony, shared
# with RealChute and AGExt).
filegroup(
    name = "modular_flight_integrator",
    srcs = ["@modular_flight_integrator//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "kspburst",
    srcs = ["@kspburst//:gamedata"],
    visibility = ["//visibility:public"],
)

# AGExt's SpaceTuxLibrary dependency (KSP_Log and other shared LGG libraries).
filegroup(
    name = "spacetuxlibrary",
    srcs = ["@spacetuxlibrary//:gamedata"],
    visibility = ["//visibility:public"],
)

# RealFuels. Installing it replaces the stock fuels throughout the part catalog, so it is only
# ever requested by the tests that check the Engine and Part classes against RealFuels.
filegroup(
    name = "realfuels",
    srcs = ["@realfuels//:gamedata"],
    visibility = ["//visibility:public"],
)

# RealFuels' engine configs for stock parts. RealFuels itself patches only tanks, so without
# these no stock engine becomes a RealFuels engine and the engine-side state does not exist.
filegroup(
    name = "realfuels_stock",
    srcs = ["@realfuels_stock//:gamedata"],
    visibility = ["//visibility:public"],
)

# The four dependencies that follow are installed alongside RealFuels and never requested on
# their own. SolverEngines and ROUtils are assembly dependencies KSP will not load RealFuels
# without; KSPCommunityFixes is in turn one of ROUtils'; and CommunityResourcePack supplies
# the resource definitions the RealFuels tank and engine configs are written against.
filegroup(
    name = "solver_engines",
    srcs = ["@solver_engines//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "routils",
    srcs = ["@routils//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "kspcommunityfixes",
    srcs = ["@kspcommunityfixes//:gamedata"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "community_resource_pack",
    srcs = ["@community_resource_pack//:gamedata"],
    visibility = ["//visibility:public"],
)
