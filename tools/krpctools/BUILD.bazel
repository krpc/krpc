genrule(
    name = "license",
    outs = ["LICENSE"],
    cmd = 'echo "%s" > "$@"' % license_text,
)

py_sdist(
    name = "krpctools",
    out = "krpctools-%s.tar.gz" % version,
    files = [
        "CHANGELOG.md",
        "README.md",
        "pyproject.toml",
        ":license",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
        "//:version",
        "//client/conformance:dist",
        "//core:KRPC.Core.net10-xmldoc",
        "//core:ServiceDefinitions",
        "//tools/ServiceDefinitions:publish",
        "//tools/TestServer:ServiceDefinitions",
        "//tools/TestServer:publish",
    ] + glob([
        "krpctools/**/*.py",
        "krpctools/**/*.tmpl",
        "krpctools/test/*.json",
        "krpctools/test/**/*.txt",
        "krpctools/test/**/*.rst",
    ]),
    path_map = {
        "version.py": "krpctools/version.py",
        "core/KRPC.Core.json": "krpctools/test/KRPC.json",
        "client/conformance/": "krpctools/conformance/",
        "core/xmldoc-net10/": "krpctools/bin/",
        "tools/krpctools/": "",
        "tools/ServiceDefinitions/publish/publish/linux-x64/": "krpctools/bin/",
        "tools/TestServer/TestService.json": "krpctools/test/TestService.json",
        "tools/TestServer/publish/publish/linux-x64/": "krpctools/bin/TestServer/",
        "tools/build/serverprocess.py": "krpctools/conformance/serverprocess.py",
    },
)

# The krpctools package as an importable python library
py_library(
    name = "krpctools_lib",
    srcs = glob(["krpctools/**/*.py"]) + [":version-py"],
    data = glob(["krpctools/**/*.tmpl"]),
    imports = ["."],
    deps = [
        "//client/python:krpc_base_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
    ],
)

genrule(
    name = "version-py",
    srcs = ["//:python_version"],
    outs = ["krpctools/version.py"],
    cmd = 'cp "$<" "$@"',
)

py_binary(
    name = "clientgen",
    srcs = ["clientgen_main.py"],
    main = "clientgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

py_binary(
    name = "docgen",
    srcs = ["docgen_main.py"],
    main = "docgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

test_suite(
    name = "test",
    tests = [
        ":conformance-test",
        ":krpctoolstest",
        ":lint",
    ],
)

deps = [
    "//client/python:krpc_lib",
    "@krpc_pypi//jinja2",
    "@krpc_pypi//protobuf",
]

py_test(
    name = "krpctoolstest",
    size = "medium",
    src = ":krpctools",
    pkg = "krpctools-" + python_version,
    tests = ["krpctools/test"],
    deps = deps,
)

# The conformance driver as the package ships it, with its bundled TestServer
native_py_test(
    name = "conformance-test",
    size = "medium",
    srcs = ["conformance_test.py"],
    args = [
        "$(rootpath :krpctools)",
        "krpctools-" + python_version,
        "$(DOTNET_BIN)",
        "$(rootpath //client/python:conformance-testee)",
        "$(rootpath //client/python:conformance/expected-failures.txt)",
        "$(rootpath //client/python:conformance/unsupported.txt)",
        "$(rootpath //client/python:conformance/conventions.json)",
    ],
    data = [
        ":krpctools",
        "//client/python:conformance-testee",
        "//client/python:conformance/conventions.json",
        "//client/python:conformance/expected-failures.txt",
        "//client/python:conformance/unsupported.txt",
        "@rules_dotnet//dotnet:resolved_toolchain",
    ],
    main = "conformance_test.py",
    # The bundled TestServer is built for linux-x64
    target_compatible_with = ["@platforms//os:linux"],
    toolchains = ["@rules_dotnet//dotnet:resolved_toolchain"],
    deps = [
        "//client/python:krpc_lib",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
    deps = [
        ":krpctools_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
    ],
)
