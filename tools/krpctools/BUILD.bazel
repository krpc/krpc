load("@rules_python//python:defs.bzl", "py_binary", "py_library", native_py_test = "py_test")
load("//:config.bzl", "python_version", "version")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test", "py_sdist", "py_test")

exports_files(["CHANGELOG.md"])

