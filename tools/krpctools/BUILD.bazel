"""

genrule(
    name = "license",
    outs = ["LICENSE"],
    cmd = 'echo "%s" > "$@"' % license_text,
)

# The server and ServiceDefinitions read API documentation from the XML file next to each
# assembly, so the package ships one beside each copy of the assemblies
xmldocs = [("ServiceDefinitions/KRPC.Core.xml", "//core:KRPC.Core.net10-xmldoc")] + [
    (
        "TestServer/%s/%s" % (rid, name),
        src,
    )
    for rid in RIDS
    for name, src in [
        ("KRPC.Benchmark.xml", "//tools/benchmarks:KRPC.Benchmark.net10-xmldoc"),
        ("KRPC.Core.xml", "//core:KRPC.Core.net10-xmldoc"),
        ("TestServer.xml", "//tools/TestServer:TestServer-xmldoc"),
    ]
]

[
    copy_file(
        name = "xmldoc-%d" % i,
        src = src,
        out = "bin/" + path,
    )
    for i, (path, src) in enumerate(xmldocs)
]

# The ServiceDefinitions tool, and the TestServer for each platform, run with dotnet. Their
# apphosts, debug symbols and runfiles files are left out.
dotnet_tools = [
    {
        "apphost": "ServiceDefinitions",
        "publish": "tools/ServiceDefinitions/publish/publish/linux-x64/",
        "target": "//tools/ServiceDefinitions:publish",
        "path": "krpctools/bin/ServiceDefinitions/",
    },
] + [
    {
        "apphost": "TestServer",
        "publish": "tools/TestServer/publish-%s/publish/%s/" % (rid, rid),
        "target": "//tools/TestServer:publish-" + rid,
        "path": "krpctools/bin/TestServer/%s/" % rid,
    }
    for rid in RIDS
]

dotnet_publishes = {tool["publish"]: tool["path"] for tool in dotnet_tools}

# A framework-dependent publish puts the native System.IO.Ports library under
# runtimes/linux-x64/native/, but its deps.json lists the library beside the assemblies
# (https://github.com/bazel-contrib/rules_dotnet/issues/594). So the library goes there.
dotnet_native_libs = {
    directory + "runtimes/linux-x64/native/": dotnet_publishes[directory]
    for directory in dotnet_publishes
}

# The krpc requirement is the version built alongside
krpc_requirement = python_version(versions["python"])

genrule(
    name = "pyproject",
    srcs = ["pyproject.toml"],
    outs = ["generated/pyproject.toml"],
    cmd = " && ".join([
        "sed 's/\"krpc >= [^\"]*\"/\"krpc >= %s\"/' $< > $@" % krpc_requirement,
        "grep -qF '\"krpc >= %s\"' $@ || { echo 'pyproject.toml has no \"krpc >= x.y.z\" dependency to set' >&2; exit 1; }" % krpc_requirement,
    ]),
)

# The blank saves, the test settings, the registry of mods and the mod config overlays of the
# KSP game
filegroup(
    name = "game-data",
    srcs = glob([
        "krpctools/game/ksp/mods/**",
        "krpctools/game/ksp/saves/*.sfs",
    ]) + [
        "krpctools/game/ksp/settings.cfg",
        ":ksp-registry",
    ],
)

copy_file(
    name = "ksp-registry",
    src = "//service:registry",
    out = "krpctools/game/ksp/registry.json",
)

# The KSP test add-on: TestingTools, and the Benchmark service its benchmarks use
ksp_addon = {
    "//tools/TestingTools": "tools/TestingTools/TestingTools/net472/",
    "//tools/benchmarks:KRPC.Benchmark.net472": "tools/benchmarks/KRPC.Benchmark.net472/net472/",
}

wheel_exclude = [
    "*.pdb",
    "*.repo_mapping",
    # The translations of System.CommandLine's messages. The tools fall back to English.
    "*.resources.dll",
    "*.runfiles_manifest",
] + [
    # An apphost takes the .exe extension when built on Windows
    tool["publish"] + tool["apphost"] + extension
    for tool in dotnet_tools
    for extension in [
        "",
        ".exe",
    ]
]

wheel_files = [
    "README.md",
    ":game-data",
    ":ksp-krpc-version",
    ":license",
    ":pyproject",
    ":version-py",
    "//:COPYING",
    "//:COPYING.LESSER",
    "//client/conformance:dist",
    "//core:ServiceDefinitions",
    "//tools/TestServer:ConformanceServiceDefinitions",
    "//tools/TestServer:DeprecatedServiceDefinitions",
    "//tools/TestServer:ServiceDefinitions",
    "//tools/TestServer:TestService2ServiceDefinitions",
    "//tools/build/protobuf:LICENSE.Google.Protobuf",
] + list(ksp_addon) + [tool["target"] for tool in dotnet_tools] + [":xmldoc-%d" % i for i in range(len(xmldocs))] + glob([
    "krpctools/**/*.py",
    "krpctools/**/*.tmpl",
    "krpctools/test/*.json",
    "krpctools/test/**/*.txt",
    "krpctools/test/**/*.rst",
])

wheel_path_map = dotnet_publishes | dotnet_native_libs | {
    path: "krpctools/game/ksp/addon/"
    for path in ksp_addon.values()
} | {
    "core/KRPC.Core.json": "krpctools/test/KRPC.json",
    "client/conformance/": "krpctools/conformance/",
    "tools/krpctools/": "",
    "tools/krpctools/generated/": "",
    "tools/krpctools/bin/": "krpctools/bin/",
    "tools/TestServer/ConformanceService.json": "krpctools/test/ConformanceService.json",
    "tools/TestServer/DeprecatedService.json": "krpctools/test/DeprecatedService.json",
    "tools/TestServer/TestService.json": "krpctools/test/TestService.json",
    "tools/TestServer/TestService2.json": "krpctools/test/TestService2.json",
    "tools/build/serverprocess.py": "krpctools/conformance/serverprocess.py",
    "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.protobuf",
}

# The published wheel, the package with its VERSION.txt. The commit stays out of the wheel the
# tests install, so they stay cached from one commit to the next.
py_wheel(
    name = "krpctools",
    out = "krpctools-%s-py3-none-any.whl" % python_version(versions["krpctools"]),
    exclude = wheel_exclude,
    files = wheel_files + [":version"],
    path_map = wheel_path_map,
)

py_wheel(
    name = "krpctools-test",
    out = "test/krpctools-%s-py3-none-any.whl" % python_version(versions["krpctools"]),
    exclude = wheel_exclude,
    files = wheel_files,
    path_map = wheel_path_map,
)

# The krpctools package as an importable python library
py_library(
    name = "krpctools_lib",
    srcs = glob(["krpctools/**/*.py"]) + [
        ":ksp-krpc-version",
        ":version-py",
    ],
    data = glob(["krpctools/**/*.tmpl"]) + [":game-data"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//client/python:krpc_base_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)

python_version_file(
    name = "version-py",
    out = "krpctools/version.py",
    version = versions["krpctools"],
)

version_file(
    name = "version",
    out = "krpctools/VERSION.txt",
    version = versions["krpctools"],
)

# The kRPC release the KSP game installs by default: the one built from this tree, which the
# bundled TestingTools add-on is built against
genrule(
    name = "ksp-krpc-version",
    outs = ["krpctools/game/ksp/krpc_version.py"],
    cmd = "echo 'KRPC_VERSION = \"%s\"' > $@" % versions["ksp"],
)

py_binary(
    name = "clientgen",
    srcs = ["clientgen_main.py"],
    main = "clientgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

py_binary(
    name = "docgen",
    srcs = ["docgen_main.py"],
    main = "docgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

test_suite(
    name = "test",
    tests = [
        ":client-names-test",
        ":cnano-prefixes-test",
        ":conformance-test",
        ":krpctoolstest",
        ":lint",
        ":naming-test",
    ],
)

deps = [
    "//client/python:krpc_lib",
    "@krpc_pypi//jinja2",
    "@krpc_pypi//protobuf",
]

py_test(
    name = "krpctoolstest",
    size = "medium",
    src = ":krpctools-test",
    tests = ["krpctools/test"],
    deps = deps,
)

# Runs krpctoolstest with each golden check rewriting its golden file in the source tree. Run it
# as //:update-goldens.
py_test(
    name = "update-goldens",
    size = "medium",
    src = ":krpctools-test",
    env = {"KRPCTOOLS_UPDATE_GOLDENS": "true"},
    tags = ["manual"],
    tests = ["krpctools/test"],
    visibility = ["//:__pkg__"],
    deps = deps,
)

# The names of client/conformance/names.json, which Starlark cannot read, and the snake case
# clientgen.bzl gives each. naming-test checks the list against the file.
NAMING_TEST_NAMES = [
    "Server",
    "MyServer",
    "ActiveVessel",
    "GForce",
    "WithANullableObject",
    "foobar",
    "referenceFrame",
    "HTTPS",
    "HTTPServer",
    "MyHTTPServer",
    "HTTPServerSSL",
    "RCSThrust",
    "MeanAnomalyAtUT",
    "DEFAULT",
    "ASet",
    "resetPID",
    "ColorRGBA",
    "EVAs",
    "IDs",
    "IDsOf",
    "MyIDs",
    "UInt",
    "ULong",
    "SInt32",
    "MyUInt64",
    "UInt64ToString",
    "FoV",
    "MaxFoV",
    "UInteger",
    "UIntValue",
    "Int32ToString",
    "ToInt32",
    "IsValidUTF8",
    "UTF8String",
    "Atan2",
    "CustomAxis01",
    "Vector3",
    "Vector3Dot",
    "Vector3D",
    "Int32s",
    "Vector3d",
    "Get3rdParty",
    "Vector32D",
    "Get2DPosition",
    "32ToString",
    "3DModel",
    "3D",
    "3rdParty",
    "HTTP_Server",
    "foo_bar",
    "Foo_UInt64",
]

write_file(
    name = "starlark-snake-case",
    out = "starlark_snake_case.json",
    content = [json.encode({x: snake_case(x) for x in NAMING_TEST_NAMES})],
)

native_py_test(
    name = "naming-test",
    size = "small",
    srcs = ["naming_test.py"],
    args = [
        "$(rootpath //client/conformance:names.json)",
        "$(rootpath :starlark-snake-case)",
    ],
    data = [
        ":starlark-snake-case",
        "//client/conformance:names.json",
    ],
    main = "naming_test.py",
    deps = [
        ":krpctools_lib",
        "@krpc_pypi//pytest",
    ],
)

# The copies of each client's escaped names, against the lists clientgen escapes with
native_py_test(
    name = "client-names-test",
    size = "small",
    srcs = ["client_names_test.py"],
    args = [
        "csharp-compiler=$(rootpath //client/csharp:src/FunctionCompiler.cs)",
        "csharp-test=$(rootpath //client/csharp:test/ConnectionNamesTest.cs)",
        "java-decoder=$(rootpath //client/java:src/krpc/client/Decoder.java)",
        "js-conventions=$(rootpath //client/js:conformance/conventions.json)",
        "js-naming=$(rootpath //client/js:src/naming.ts)",
        "lua-connection=$(rootpath //client/lua:krpc/connection.lua)",
        "lua-conventions=$(rootpath //client/lua:conformance/conventions.json)",
        "lua-service=$(rootpath //client/lua:krpc/service.lua)",
        "python-conventions=$(rootpath //client/python:conformance/conventions.json)",
    ],
    data = [
        "//client/csharp:src/FunctionCompiler.cs",
        "//client/csharp:test/ConnectionNamesTest.cs",
        "//client/java:src/krpc/client/Decoder.java",
        "//client/js:conformance/conventions.json",
        "//client/js:src/naming.ts",
        "//client/lua:conformance/conventions.json",
        "//client/lua:krpc/connection.lua",
        "//client/lua:krpc/service.lua",
        "//client/python:conformance/conventions.json",
    ],
    main = "client_names_test.py",
    deps = [
        ":krpctools_lib",
        "@krpc_pypi//pytest",
    ],
)

native_py_test(
    name = "cnano-prefixes-test",
    size = "small",
    srcs = ["cnano_prefixes_test.py"],
    args = ["$(rootpaths //client/cnano:library-sources)"],
    data = ["//client/cnano:library-sources"],
    main = "cnano_prefixes_test.py",
    deps = [
        ":krpctools_lib",
        "@krpc_pypi//pytest",
    ],
)

# The conformance driver as the package ships it, with its bundled TestServer
native_py_test(
    name = "conformance-test",
    size = "medium",
    srcs = ["conformance_test.py"],
    args = [
        "$(rootpath :krpctools-test)",
        "$(DOTNET_BIN)",
        "$(rootpath //client/python:conformance-testee)",
        "$(rootpath //client/python:conformance/expected-failures.txt)",
        "$(rootpath //client/python:conformance/unsupported.txt)",
        "$(rootpath //client/python:conformance/conventions.json)",
    ],
    data = [
        ":krpctools-test",
        "//client/python:conformance-testee",
        "//client/python:conformance/conventions.json",
        "//client/python:conformance/expected-failures.txt",
        "//client/python:conformance/unsupported.txt",
        "@rules_dotnet//dotnet:resolved_toolchain",
    ],
    main = "conformance_test.py",
    toolchains = ["@rules_dotnet//dotnet:resolved_toolchain"],
    deps = [
        "//client/python:krpc_lib",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
    # The full client, as the KSP test case imports the KSP services' modules
    deps = [
        ":krpctools_lib",
        "//client/python:krpc_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)
