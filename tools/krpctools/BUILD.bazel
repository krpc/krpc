load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", native_py_test = "py_test")
load("//:config.bzl", "python_version", "version_parts")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test", "py_test", "py_wheel")
load("//tools/TestServer:rids.bzl", "RIDS")

exports_files(["CHANGELOG.md"])

license_text = """This license (LGPL v3) applies to all parts of krpctools except for the following:

  - System.CommandLine.dll, in krpctools/bin/, is under the MIT license.
    See https://www.nuget.org/packages/System.CommandLine/

  - Google.Protobuf.dll, in krpctools/bin/, is from Google's protobuf project.
    See LICENSE.protobuf

  - System.IO.Ports.dll and libSystem.IO.Ports.Native.so, in krpctools/bin/, are from the
    .NET project.
    See https://github.com/dotnet/runtime

  - TestingTools.dll, in krpctools/game/ksp/addon/, contains code adapted from the
    AutoLoadGame plugin, released under the MIT License (MIT) by Allis Tauri.

  - As an additional permission under section 7 of the GNU GPL v3, code that krpctools
    generates for a client is under the license of that client, whatever the license of
    krpctools or of the service it is generated from.

Copyright 2015-2026 kRPC Org

This program is free software: you can redistribute it and/or modify
it under the terms of the Lesser GNU General Public License as published by
the Free Software Foundation, either version 3 of the License, or
(at your option) any later version.

This program is distributed in the hope that it will be useful,
but WITHOUT ANY WARRANTY; without even the implied warranty of
MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
Lesser GNU General Public License for more details.

You should have received a copy of the Lesser GNU General Public License
along with this program.  If not, see <http://www.gnu.org/licenses/>.
"""

genrule(
    name = "license",
    outs = ["LICENSE"],
    cmd = 'echo "%s" > "$@"' % license_text,
)

# The server and ServiceDefinitions read API documentation from the XML file next to each
# assembly, so the package ships one beside each copy of the assemblies
xmldocs = [("ServiceDefinitions/KRPC.Core.xml", "//core:KRPC.Core.net10-xmldoc")] + [
    (
        "TestServer/%s/%s" % (rid, name),
        src,
    )
    for rid in RIDS
    for name, src in [
        ("KRPC.Benchmark.xml", "//tools/benchmarks:KRPC.Benchmark.net10-xmldoc"),
        ("KRPC.Core.xml", "//core:KRPC.Core.net10-xmldoc"),
        ("TestServer.xml", "//tools/TestServer:TestServer-xmldoc"),
    ]
]

[
    copy_file(
        name = "xmldoc-%d" % i,
        src = src,
        out = "bin/" + path,
    )
    for i, (path, src) in enumerate(xmldocs)
]

# The ServiceDefinitions tool, and the TestServer for each platform, run with dotnet. Their
# apphosts, debug symbols and runfiles files are left out.
dotnet_tools = [
    {
        "apphost": "ServiceDefinitions",
        "publish": "tools/ServiceDefinitions/publish/publish/linux-x64/",
        "target": "//tools/ServiceDefinitions:publish",
        "path": "krpctools/bin/ServiceDefinitions/",
    },
] + [
    {
        "apphost": "TestServer",
        "publish": "tools/TestServer/publish-%s/publish/%s/" % (rid, rid),
        "target": "//tools/TestServer:publish-" + rid,
        "path": "krpctools/bin/TestServer/%s/" % rid,
    }
    for rid in RIDS
]

dotnet_publishes = {tool["publish"]: tool["path"] for tool in dotnet_tools}

# A framework-dependent publish puts the native System.IO.Ports library under
# runtimes/linux-x64/native/, but its deps.json lists the library beside the assemblies
# (https://github.com/bazel-contrib/rules_dotnet/issues/594). So the library goes there.
dotnet_native_libs = {
    directory + "runtimes/linux-x64/native/": dotnet_publishes[directory]
    for directory in dotnet_publishes
}

# The krpc requirement is the version built alongside. A dev build, x.y.z.devN, sorts below
# x.y.z, so it requires x.y.z.dev0.
krpc_requirement = python_version.partition(".dev")[0] + (".dev0" if ".dev" in python_version else "")

genrule(
    name = "pyproject",
    srcs = ["pyproject.toml"],
    outs = ["generated/pyproject.toml"],
    cmd = " && ".join([
        "sed 's/\"krpc >= [^\"]*\"/\"krpc >= %s\"/' $< > $@" % krpc_requirement,
        "grep -qF '\"krpc >= %s\"' $@ || { echo 'pyproject.toml has no \"krpc >= x.y.z\" dependency to set' >&2; exit 1; }" % krpc_requirement,
    ]),
)

# The blank saves, the test settings and the mod config overlays of the KSP game
filegroup(
    name = "game-data",
    srcs = glob(
        [
            "krpctools/game/ksp/mods/**",
            "krpctools/game/ksp/saves/*.sfs",
        ],
        exclude = ["**/*.py"],
    ) + ["krpctools/game/ksp/settings.cfg"],
)

# The KSP test add-on: TestingTools, and the Benchmark service its benchmarks use
ksp_addon = {
    "//tools/TestingTools": "tools/TestingTools/TestingTools/net472/",
    "//tools/benchmarks:KRPC.Benchmark.net472": "tools/benchmarks/KRPC.Benchmark.net472/net472/",
}

py_wheel(
    name = "krpctools",
    out = "krpctools-%s-py3-none-any.whl" % python_version,
    exclude = [
        "*.pdb",
        "*.repo_mapping",
        # The translations of System.CommandLine's messages. The tools fall back to English.
        "*.resources.dll",
        "*.runfiles_manifest",
    ] + [
        # An apphost takes the .exe extension when built on Windows
        tool["publish"] + tool["apphost"] + extension
        for tool in dotnet_tools
        for extension in [
            "",
            ".exe",
        ]
    ],
    files = [
        "README.md",
        ":game-data",
        ":ksp-krpc-version",
        ":license",
        ":pyproject",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
        "//client/conformance:dist",
        "//core:ServiceDefinitions",
        "//tools/TestServer:ConformanceServiceDefinitions",
        "//tools/TestServer:ServiceDefinitions",
        "//tools/TestServer:TestService2ServiceDefinitions",
        "//tools/build/protobuf:LICENSE.Google.Protobuf",
    ] + list(ksp_addon) + [tool["target"] for tool in dotnet_tools] + [":xmldoc-%d" % i for i in range(len(xmldocs))] + glob([
        "krpctools/**/*.py",
        "krpctools/**/*.tmpl",
        "krpctools/test/*.json",
        "krpctools/test/**/*.txt",
        "krpctools/test/**/*.rst",
    ]),
    path_map = dotnet_publishes | dotnet_native_libs | {
        path: "krpctools/game/ksp/addon/"
        for path in ksp_addon.values()
    } | {
        "version.py": "krpctools/version.py",
        "core/KRPC.Core.json": "krpctools/test/KRPC.json",
        "client/conformance/": "krpctools/conformance/",
        "tools/krpctools/": "",
        "tools/krpctools/generated/": "",
        "tools/krpctools/bin/": "krpctools/bin/",
        "tools/TestServer/ConformanceService.json": "krpctools/test/ConformanceService.json",
        "tools/TestServer/TestService.json": "krpctools/test/TestService.json",
        "tools/TestServer/TestService2.json": "krpctools/test/TestService2.json",
        "tools/build/serverprocess.py": "krpctools/conformance/serverprocess.py",
        "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.protobuf",
    },
)

# The krpctools package as an importable python library
py_library(
    name = "krpctools_lib",
    srcs = glob(["krpctools/**/*.py"]) + [
        ":ksp-krpc-version",
        ":version-py",
    ],
    data = glob(["krpctools/**/*.tmpl"]) + [":game-data"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//client/python:krpc_base_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)

genrule(
    name = "version-py",
    srcs = ["//:python_version"],
    outs = ["krpctools/version.py"],
    cmd = 'cp "$<" "$@"',
)

# The kRPC release the KSP game installs by default: the one built from this tree, which the
# bundled TestingTools add-on is built against
genrule(
    name = "ksp-krpc-version",
    outs = ["krpctools/game/ksp/krpc_version.py"],
    cmd = "echo 'KRPC_VERSION = \"%s\"' > $@" % ".".join(version_parts[:3]),
)

py_binary(
    name = "clientgen",
    srcs = ["clientgen_main.py"],
    main = "clientgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

py_binary(
    name = "docgen",
    srcs = ["docgen_main.py"],
    main = "docgen_main.py",
    visibility = ["//visibility:public"],
    deps = [":krpctools_lib"],
)

test_suite(
    name = "test",
    tests = [
        ":conformance-test",
        ":krpctoolstest",
        ":lint",
    ],
)

deps = [
    "//client/python:krpc_lib",
    "@krpc_pypi//jinja2",
    "@krpc_pypi//protobuf",
]

py_test(
    name = "krpctoolstest",
    size = "medium",
    src = ":krpctools",
    tests = ["krpctools/test"],
    deps = deps,
)

# The conformance driver as the package ships it, with its bundled TestServer
native_py_test(
    name = "conformance-test",
    size = "medium",
    srcs = ["conformance_test.py"],
    args = [
        "$(rootpath :krpctools)",
        "$(DOTNET_BIN)",
        "$(rootpath //client/python:conformance-testee)",
        "$(rootpath //client/python:conformance/expected-failures.txt)",
        "$(rootpath //client/python:conformance/unsupported.txt)",
        "$(rootpath //client/python:conformance/conventions.json)",
    ],
    data = [
        ":krpctools",
        "//client/python:conformance-testee",
        "//client/python:conformance/conventions.json",
        "//client/python:conformance/expected-failures.txt",
        "//client/python:conformance/unsupported.txt",
        "@rules_dotnet//dotnet:resolved_toolchain",
    ],
    main = "conformance_test.py",
    toolchains = ["@rules_dotnet//dotnet:resolved_toolchain"],
    deps = [
        "//client/python:krpc_lib",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "*.py",
        "krpctools/**/*.py",
    ]),
    deps = [
        ":krpctools_lib",
        "@krpc_pypi//jinja2",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)
