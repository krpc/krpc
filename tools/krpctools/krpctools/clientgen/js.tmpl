// The TypeScript module of the {{ service_name }} service, generated by krpc-clientgen. The
// client builds the service at run time, and uses the enumerations, structures and exceptions
// declared here where the server's definitions match.
{% for x in imports %}
{{ x }}
{% endfor %}

{% for line in service_documentation %}
{{ line }}
{% endfor %}
{% if members %}
export interface Service extends RemoteService<"{{ service_name }}"> {
{{ members }}
}
{% else %}
export interface Service extends RemoteService<"{{ service_name }}"> {}
{% endif %}
{% for x in classes %}

{% for line in x.documentation %}
{{ line }}
{% endfor %}
{% if x.members %}
export interface {{ x.name }} extends RemoteObject<"{{ x.brand }}"> {
{{ x.members }}
}
{% else %}
export interface {{ x.name }} extends RemoteObject<"{{ x.brand }}"> {}
{% endif %}
{% endfor %}
{% for x in enumerations %}

{% for line in x.documentation %}
{{ line }}
{% endfor %}
export type {{ x.name }} = {{ x.base }}<"{{ x.brand }}">;
{% for line in x.deprecated %}
{{ line }}
{% endfor %}
export const {{ x.name }} = declareEnumeration<Service["{{ x.name }}"]>({{ x.arguments }});
{% endfor %}
{% for x in structs %}

{% for line in x.documentation %}
{{ line }}
{% endfor %}
{% if x.fields %}
export interface {{ x.name }} extends RemoteStruct<"{{ x.brand }}"> {
{{ x.fields }}
}
{% else %}
export interface {{ x.name }} extends RemoteStruct<"{{ x.brand }}"> {}
{% endif %}
{% for line in x.deprecated %}
{{ line }}
{% endfor %}
export const {{ x.name }} = declareStruct<Service["{{ x.name }}"]>({{ x.arguments }});
{% endfor %}
{% for x in exceptions %}

{% for line in x.documentation %}
{{ line }}
{% endfor %}
export type {{ x.name }} = {{ x.type }};
{% for line in x.deprecated %}
{{ line }}
{% endfor %}
export const {{ x.name }} = declareException<Service["{{ x.name }}"]>({{ x.arguments }});
{% endfor %}
{% if uses_client_service %}

type ClientService = Service;
{% endif %}

/** The service and its classes as a compiled function reads them: a property is a property,
 * and a method returns its value. */
export declare namespace Server {
{% if server_members %}
  interface Service extends ServerObject<"{{ service_name }}"> {
{{ server_members }}
  }
{% else %}
  interface Service extends ServerObject<"{{ service_name }}"> {}
{% endif %}
{% for x in server_classes %}

{% for line in x.documentation %}
  {{ line }}
{% endfor %}
{% if x.members %}
  interface {{ x.name }} extends ServerObject<"{{ x.brand }}"> {
{{ x.members }}
  }
{% else %}
  interface {{ x.name }} extends ServerObject<"{{ x.brand }}"> {}
{% endif %}
{% endfor %}
}

declare module "@krpc-org/krpc" {
  interface ServerTypes {
    "{{ service_name }}": Server.Service;
{% for x in server_classes %}
    "{{ x.brand }}": Server.{{ x.name }};
{% endfor %}
  }
  interface ClientTypes {
    "{{ service_name }}": Service;
{% for x in server_classes %}
    "{{ x.brand }}": {{ x.name }};
{% endfor %}
  }
}
