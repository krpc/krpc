// The conformance testee's dispatch for the {{ service_name }} service, generated by clientgen.
#pragma once

#include <stdexcept>
#include <string>

#include "dispatch_values.hpp"

{% macro pass(p) %}{% if p.optional %}{{ p.name }} ? &*{{ p.name }} : nullptr{% elif p.by_pointer %}&{{ p.name }}{% else %}{{ p.name }}{% endif %}{% endmacro %}
namespace krpc_conformance {
{% for struct in structs %}

struct {{ service_name }}_{{ struct.name }} {
  using type = {{ struct.ctype }};
  static type arg(const Value& value) {
    const auto& fields = not_null(value).struct_().fields();
    type result{};
    {% for field in struct.fields %}
    result.{{ struct.field_names[loop.index0] }} = {{ field.element }}::arg(fields.Get({{ loop.index0 }}));
    {% endfor %}
    return result;
  }
  static Value result(const type& x) {
    Value value;
    auto* fields = value.mutable_struct_();
    fields->set_name("{{ struct.name }}");
    {% for field in struct.fields %}
    *fields->add_fields() = {{ field.element }}::result(x.{{ struct.field_names[loop.index0] }});
    {% endfor %}
    return value;
  }
};
{% endfor %}
{% for tuple in tuples %}

struct {{ tuple.name }} {
  using type = {{ tuple.ctype }};
  static type arg(const Value& value) {
    const auto& items = not_null(value).tuple().items();
    type result{};
    {% for item in tuple["items"] %}
    result.e{{ loop.index0 }} = {{ item }}::arg(items.Get({{ loop.index0 }}));
    {% endfor %}
    return result;
  }
  static Value result(const type& x) {
    Value value;
    auto* items = value.mutable_tuple();
    {% for item in tuple["items"] %}
    *items->add_items() = {{ item }}::result(x.e{{ loop.index0 }});
    {% endfor %}
    return value;
  }
};
{% endfor %}

inline Value invoke_{{ service_name | snake_case }}(krpc_connection_t connection, const std::string& procedure,
                       const Arguments& args) {
  {% for member in members %}
  if (procedure == "{{ member.remote_name }}" && args.size() == {{ member.parameters | length }}) {
    {% for p in member.parameters %}
    {% if p.optional %}
    auto {{ p.name }} = optional_arg<{{ p.tag }}>(args.Get({{ p.index }}));
    {% else %}
    auto {{ p.name }} = {{ p.tag }}::arg(args.Get({{ p.index }}));
    {% endif %}
    {% endfor %}
    {% if member.result %}
    {{ member.result.ctype }} result{};
    {% if member.result.null_flag %}
    bool result_is_null = false;
    {% endif %}
    check({{ member.variants[-1].call }}(connection, &result{% if member.result.null_flag %}, &result_is_null{% endif %}{% for p in member.parameters %}, {{ pass(p) }}{% endfor %}));
    {% if member.result.null_flag %}
    if (result_is_null) return result_null();
    {% endif %}
    return {{ member.result.tag }}::result(result);
    {% else %}
    check({{ member.variants[-1].call }}(connection{% for p in member.parameters %}, {{ pass(p) }}{% endfor %}));
    return result_none();
    {% endif %}
  }
  {% endfor %}
  throw std::invalid_argument("The testee cannot call {{ service_name }}." + procedure + " with " +
                              std::to_string(args.size()) + " arguments");
}

}  // namespace krpc_conformance
