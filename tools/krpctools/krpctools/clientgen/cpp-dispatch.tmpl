// The conformance testee's dispatch for the {{ service_name }} service, generated by clientgen.
#pragma once

#include <stdexcept>
#include <string>

#include "dispatch_values.hpp"

namespace krpc_conformance {
{% for struct in structs %}

struct {{ service_name }}_{{ struct.name }} {
  using type = {{ struct.class }};
  static type arg(::krpc::Client& client, const Value& value) {
    const auto& fields = not_null(value).struct_().fields();
    return type(
      {% for field in struct.fields %}
      {{ field.tag }}::arg(client, fields.Get({{ loop.index0 }})){% if not loop.last %},{% endif %}

      {% endfor %}
    );
  }
  static Value result(const type& x) {
    Value value;
    auto* fields = value.mutable_struct_();
    fields->set_name("{{ struct.name }}");
    {% for field in struct.fields %}
    *fields->add_fields() = {{ field.tag }}::result(x.{{ struct.field_names[loop.index0] }});
    {% endfor %}
    return value;
  }
};
{% endfor %}

inline Value invoke_{{ service_name | snake_case }}(::krpc::Client& client, const std::string& procedure,
                       const Arguments& args) {
  {% for member in members %}
  {% for variant in member.variants %}
  if (procedure == "{{ member.remote_name }}" && args.size() == {{ variant.count }}) {
    {% for p in variant.parameters %}
    auto {{ p.name }} = {{ p.tag }}::arg(client, args.Get({{ p.index }}));
    {% endfor %}
    {% if member.result %}
    return {{ member.result.tag }}::result({{ variant.call }});
    {% else %}
    {{ variant.call }};
    return result_none();
    {% endif %}
  }
  {% endfor %}
  {% endfor %}
  throw std::invalid_argument("The testee cannot call {{ service_name }}." + procedure + " with " +
                              std::to_string(args.size()) + " arguments");
}

inline StreamHandle add_stream_{{ service_name | snake_case }}(::krpc::Client& client,
                                  const std::string& procedure, const Arguments& args) {
  {% for member in members if member.stream %}
  {% for variant in member.variants %}
  if (procedure == "{{ member.remote_name }}" && args.size() == {{ variant.count }}) {
    {% for p in variant.parameters %}
    auto {{ p.name }} = {{ p.tag }}::arg(client, args.Get({{ p.index }}));
    {% endfor %}
    return result_stream({{ variant.stream }}, [](const auto& x) { return {{ member.result.tag }}::result(x); });
  }
  {% endfor %}
  {% endfor %}
  throw std::invalid_argument("The testee cannot stream {{ service_name }}." + procedure + " with " +
                              std::to_string(args.size()) + " arguments");
}

inline ::krpc::schema::ProcedureCall call_{{ service_name | snake_case }}(::krpc::Client& client,
                                  const std::string& procedure, const Arguments& args) {
  {% for member in members if member.stream %}
  {% for variant in member.variants %}
  if (procedure == "{{ member.remote_name }}" && args.size() == {{ variant.count }}) {
    {% for p in variant.parameters %}
    auto {{ p.name }} = {{ p.tag }}::arg(client, args.Get({{ p.index }}));
    {% endfor %}
    return {{ variant.procedure_call }};
  }
  {% endfor %}
  {% endfor %}
  throw std::invalid_argument("The testee cannot build a call of {{ service_name }}." + procedure +
                              " with " + std::to_string(args.size()) + " arguments");
}

/** Set the service and name of an error that is an instance of an exception type of the
    {{ service_name }} service, and return whether it is. */
inline bool name_error_{{ service_name | snake_case }}(const std::exception& exn, ::krpc::conformance::Error* error) {
  {% for name in exceptions %}
  if (dynamic_cast<const ::krpc::services::{{ service_name }}::{{ name }}*>(&exn) != nullptr) {
    error->set_service("{{ service_name }}");
    error->set_name("{{ name }}");
    return true;
  }
  {% endfor %}
  return false;
}

}  // namespace krpc_conformance
