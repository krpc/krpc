load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//:config.bzl", "python_version")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test", "py_test", "py_wheel")

# The krpctest package as an importable python library, for use by other
# python targets in this workspace
py_library(
    name = "krpctest_lib",
    srcs = glob(["krpctest/**/*.py"]) + [":version-py"],
    data = [":data"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//client/python:krpc_lib",
        "@krpc_pypi//pytest",
    ],
)

# The blank saves, the test settings and the mod config overlays
filegroup(
    name = "data",
    srcs = glob(
        [
            "krpctest/ksp/mods/**",
            "krpctest/ksp/saves/*.sfs",
        ],
        exclude = ["**/*.py"],
    ) + ["krpctest/ksp/settings.cfg"],
)

# The game the repository's in-game tests run against: KSP, with kRPC built from the sources
py_library(
    name = "bazel_ksp",
    srcs = ["bazel_ksp.py"],
    imports = ["."],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpctest_lib"],
)

genrule(
    name = "version-py",
    srcs = ["//:python_version"],
    outs = ["krpctest/version.py"],
    cmd = 'cp "$<" "$@"',
)

# Run the integration tests that need the game: `bazel run //:test-ingame -- [pytest args]`.
# The tests themselves are read from the repository (the runner works there rather than in
# the runfiles tree), so adding or editing one needs no change here.
py_binary(
    name = "test-ingame",
    srcs = ["run_tests.py"],
    main = "run_tests.py",
    visibility = ["//visibility:public"],
    deps = [
        ":bazel_ksp",
        "@krpc_pypi//pytest",
    ],
)

# Install the mod and run the game: `bazel run //:run-ksp -- [--mods=... --load-*=...]`.
# This is `krpc-game run` against BazelKSP.
py_binary(
    name = "run-ksp",
    srcs = ["run_ksp.py"],
    main = "run_ksp.py",
    visibility = ["//visibility:public"],
    deps = [":bazel_ksp"],
)

py_wheel(
    name = "krpctest",
    out = "krpctest-%s-py3-none-any.whl" % python_version,
    files = [
        "LICENSE",
        "README.md",
        "pyproject.toml",
        ":data",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
    ] + glob(["krpctest/**/*.py"]),
    path_map = {
        "version.py": "krpctest/version.py",
        "tools/krpctest/": "",
    },
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test",
    tests = [
        ":krpctesttest",
        ":lint",
    ],
)

deps = [
    "//client/python:krpc_lib",
    "@krpc_pypi//protobuf",
]

py_test(
    name = "krpctesttest",
    size = "medium",
    src = ":krpctest",
    deps = deps,
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "*.py",
        "krpctest/**/*.py",
    ]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "*.py",
        "krpctest/**/*.py",
    ]),
    deps = [
        ":krpctest_lib",
        "@krpc_pypi//protobuf",
        "@krpc_pypi//pytest",
    ],
)
