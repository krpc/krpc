load("//:config.bzl", "python_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test", "py_sdist", "py_test")

py_sdist(
    name = "krpcserialio",
    out = "krpcserialio-%s.tar.gz" % version,
    files = [
        "pyproject.toml",
        "//:python_version",
        "//:version",
    ] + glob(["krpcserialio/**/*"]),
    path_map = {
        "version.py": "krpcserialio/version.py",
        "client/serialio/": "",
    },
)

test_suite(
    name = "test",
    tests = [
        ":iotest",
        ":lint",
    ],
)

client_test(
    name = "iotest",
    size = "medium",
    server_executable = "//tools/TestServer",
    server_type = "serialio",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":iotestexe",
)

deps = [
    "//client/python:krpc_lib",
    "@pypi//protobuf",
    "@pypi//pyserial",
]

py_test(
    name = "iotestexe",
    size = "small",
    src = ":krpcserialio",
    pkg = "krpcserialio-" + python_version,
    tags = ["requires-network"],
    deps = deps,
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["krpcserialio/**/*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["krpcserialio/**/*.py"]),
    deps = deps,
)
