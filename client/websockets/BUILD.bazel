load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

test_suite(
    name = "test",
    tests = [
        ":conformance",
        ":lint",
    ],
)

deps = [
    "//client/python:krpc_lib",
    "@krpc_pypi//protobuf",
    "@krpc_pypi//websocket_client",
]

# A minimal testee, to run the conformance tests over websockets
py_binary(
    name = "conformance-testee",
    srcs = ["conformance/testee.py"],
    main = "conformance/testee.py",
    deps = deps + ["//client/conformance:testee_py"],
)

conformance_test(
    name = "conformance",
    size = "medium",
    expected_failures = "conformance/expected-failures.txt",
    profiles = ["core"],
    protocols = ["websockets"],
    tags = ["requires-network"],
    testee = ":conformance-testee",
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["conformance/*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["conformance/*.py"]),
    deps = deps + ["//client/conformance:testee_py"],
)
