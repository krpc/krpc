load("@rules_java//java:defs.bzl", "java_binary", "java_library", "java_test")
load("//:config.bzl", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:java.bzl", "java_checkstyle_test", "javadoc_test")
load("//tools/krpctools:clientgen.bzl", "clientgen_dispatch", "clientgen_services")

exports_files([
    "CHANGELOG.md",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

services = clientgen_services("java")

copts = [
    "-Werror",
    "-Xlint:all",
]

filegroup(
    name = "java",
    srcs = [":krpc-jar"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "krpc-jar",
    srcs = [":krpc"],
    outs = ["krpc-java-%s.jar" % version],
    cmd = 'cp "$<" "$@"',
    output_to_bindir = True,
    visibility = ["//visibility:public"],
)

java_library(
    name = "krpc",
    srcs = glob(["src/krpc/**/*.java"]) + services + ["//protobuf:java"],
    javacopts = copts,
    resources = [
        "CHANGELOG.md",
        "LICENSE",
        "README.txt",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_javatuples_javatuples",
    ],
)

java_library(
    name = "testlib",
    srcs = glob(["test/**/*.java"]) + [":services-testservice"],
    javacopts = copts,
    deps = [
        ":krpc",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:junit_junit",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_javatuples_javatuples",
    ],
)

test_runtime_deps = [
    ":krpc",
    ":testlib",
    "@maven//:com_google_protobuf_protobuf_java",
    "@maven//:junit_junit",
    "@maven//:org_hamcrest_hamcrest",
    "@maven//:org_javatuples_javatuples",
]

# What the client does regardless of the transport it talks over: encoding and decoding the
# values a call carries. It needs no server, so it runs on its own rather than under the
# harness that starts one.
java_test(
    name = "unit",
    size = "small",
    javacopts = copts,
    main_class = "krpc.client.UnitTestSuite",
    runtime_deps = test_runtime_deps,
)

# The transport, one test each. Both run against a server the test listens on itself, which
# answers the handshake and every request after it, so neither needs a kRPC server.
java_test(
    name = "communication-tcpip",
    size = "small",
    javacopts = copts,
    main_class = "krpc.client.TcpIpConnectionTestSuite",
    tags = ["requires-network"],
    runtime_deps = test_runtime_deps,
)

java_test(
    name = "communication-localsocket",
    size = "small",
    javacopts = copts,
    main_class = "krpc.client.LocalSocketConnectionTestSuite",
    runtime_deps = test_runtime_deps,
)

# The tests that talk to a server, run end to end against a TestServer by the targets below
java_test(
    name = "testexe",
    size = "medium",
    javacopts = copts,
    main_class = "krpc.client.TestSuite",
    tags = ["requires-network"],
    runtime_deps = test_runtime_deps,
)

# The benchmark program, run by //tools/benchmarks:java. Not a test: it measures.
java_binary(
    name = "benchmark",
    srcs = ["benchmark/krpc/client/Benchmark.java"] + [":services-testservice"],
    javacopts = copts,
    main_class = "krpc.client.Benchmark",
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [
        ":krpc",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:org_javatuples_javatuples",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":client-localsocket",
        ":client-tcpip",
        ":communication-localsocket",
        ":communication-tcpip",
        ":conformance",
        ":javadoc",
        ":lint",
        ":unit",
    ],
)

# The client end to end against a TestServer, once per transport it can reach one over.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":testexe",
    visibility = ["//:__pkg__"],
)

client_test(
    name = "client-localsocket",
    size = "medium",
    server_executable = "//tools/TestServer",
    server_type = "localsocket",
    test_executable = ":testexe",
    visibility = ["//:__pkg__"],
)

# The conformance tests, driving the client through its testee
java_binary(
    name = "conformance-testee",
    testonly = True,
    srcs = glob(["conformance/**/*.java"]) + clientgen_dispatch(
        out = "conformance/{service}Dispatch.java",
        language = "java",
    ) + [
        ":services-testservice",
        "//client/conformance:testee-java",
    ],
    javacopts = copts,
    main_class = "krpc.client.conformance.Main",
    deps = [
        ":krpc",
        "@maven//:com_google_code_gson_gson",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_google_protobuf_protobuf_java_util",
        "@maven//:org_javatuples_javatuples",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    conventions = "conformance/conventions.json",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "error-types",
        "streams",
        "events",
        "functions",
        "connections",
        "threads",
        "callbacks",
        "conditions",
        "ordering",
        "races",
    ],
    protocols = [
        "tcpip",
        "localsocket",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

java_checkstyle_test(
    name = "lint",
    size = "small",
    srcs = glob(["**/*.java"]),
)

# The documentation of the client and of the test service, which exercises every form the
# documentation takes, as javadoc reads it
javadoc_test(
    name = "javadoc",
    size = "small",
    srcs = glob(["src/krpc/**/*.java"]) + services + [":services-testservice"],
    deps = [":krpc"],
)
