load("@rules_dotnet//dotnet:defs.bzl", "csharp_binary", "csharp_library", "csharp_nunit_test")
load("//:config.bzl", "assembly_version", "author", "nuget_version")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:nuget.bzl", "nuget_package")
load("//tools/krpctools:clientgen.bzl", "clientgen_csharp")

exports_files(["CHANGELOG.md"])

# Default target for the package, so `bazel build //client/csharp` builds the
# release artifact, matching the other clients.
alias(
    name = "csharp",
    actual = ":nuget",
    visibility = ["//visibility:public"],
)

nuget_package(
    name = "nuget",
    assembly = ":KRPC.Client",
    author = author,
    description = "C# client for kRPC",
    framework = "net472",
    id = "KRPC.Client",
    license = "LGPL-3.0-only",
    project_url = "https://github.com/krpc/krpc",
    readme = "README.md",
    version = nuget_version,
    deps = {
        "Google.Protobuf": "3.35.1",
    },
)

csharp_assembly_info(
    name = "AssemblyInfo",
    cls_compliant = False,
    copyright = author,
    description = "C# client for kRPC",
    title = "KRPC.Client",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to //:csproj-deps so it can copy AssemblyInfo.cs to generated_deps
    ],
)

srcs = glob(["src/**/*.cs"]) + [
    ":AssemblyInfo",
    "//protobuf:csharp",
    ":services-krpc",
    ":services-spacecenter",
    ":services-drawing",
    ":services-infernalrobotics",
    ":services-kerbalalarmclock",
    ":services-remotetech",
    ":services-ui",
    ":services-lidar",
    ":services-debug",
    ":services-dockingcamera",
]

deps = [
    "//tools/build/dotnet:Google.Protobuf.net45",
    "//tools/build/dotnet:System.Memory",
    "//tools/build/dotnet:System.Runtime.CompilerServices.Unsafe",
]

# The test assemblies, which reach the internals of the client: the transport, the message
# reader and the endpoint a unix domain socket is named by are not part of its public API.
test_assemblies = [
    "KRPC.Client.Test",
    "KRPC.Client.Test.CommunicationLocalSocket",
    "KRPC.Client.Test.CommunicationTCPIP",
    "KRPC.Client.Test.Unit",
]

csharp_library(
    name = "KRPC.Client",
    srcs = srcs,
    internals_visible_to = test_assemblies,
    # CS1702: Google.Protobuf references an older System.Memory than the one
    # supplied; assembly unification handles this at runtime (MSBuild
    # suppresses this warning by default)
    nowarn = [
        "CS1685",
        "CS1702",
    ],
    target_frameworks = ["net472"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = deps,
)

# net8.0 build of the client, for the unit tests. A separate target rather
# than a multi-targeted KRPC.Client so that the default build flavor staged
# into the nupkg stays net472.
csharp_library(
    name = "KRPC.Client.net8",
    srcs = srcs,
    out = "KRPC.Client",
    internals_visible_to = test_assemblies,
    # CS1701: Google.Protobuf's net5.0 build references net5-era framework
    # assemblies; unification handles this at runtime (MSBuild suppresses
    # this warning by default)
    nowarn = [
        "CS1685",
        "CS1701",
    ],
    target_frameworks = ["net8.0"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = ["//tools/build/dotnet:Google.Protobuf"],
)

clientgen_csharp(
    name = "services-krpc",
    out = "Services/KRPC.cs",
    defs = "//core:ServiceDefinitions",
    service = "KRPC",
    visibility = [
        "//:__pkg__",
    ],
)

clientgen_csharp(
    name = "services-spacecenter",
    out = "Services/SpaceCenter.cs",
    defs = "//service/SpaceCenter:ServiceDefinitions",
    service = "SpaceCenter",
    visibility = [
        "//:__pkg__",
    ],
)

clientgen_csharp(
    name = "services-drawing",
    out = "Services/Drawing.cs",
    defs = "//service/Drawing:ServiceDefinitions",
    service = "Drawing",
)

clientgen_csharp(
    name = "services-infernalrobotics",
    out = "Services/InfernalRobotics.cs",
    defs = "//service/InfernalRobotics:ServiceDefinitions",
    service = "InfernalRobotics",
    visibility = [
        "//:__pkg__",
    ],
)

clientgen_csharp(
    name = "services-kerbalalarmclock",
    out = "Services/KerbalAlarmClock.cs",
    defs = "//service/KerbalAlarmClock:ServiceDefinitions",
    service = "KerbalAlarmClock",
    visibility = [
        "//:__pkg__",
    ],
)

clientgen_csharp(
    name = "services-remotetech",
    out = "Services/RemoteTech.cs",
    defs = "//service/RemoteTech:ServiceDefinitions",
    service = "RemoteTech",
)

clientgen_csharp(
    name = "services-ui",
    out = "Services/UI.cs",
    defs = "//service/UI:ServiceDefinitions",
    service = "UI",
)

clientgen_csharp(
    name = "services-lidar",
    out = "Services/LiDAR.cs",
    defs = "//service/LiDAR:ServiceDefinitions",
    service = "LiDAR",
)

clientgen_csharp(
    name = "services-dockingcamera",
    out = "Services/DockingCamera.cs",
    defs = "//service/DockingCamera:ServiceDefinitions",
    service = "DockingCamera",
)

clientgen_csharp(
    name = "services-debug",
    out = "Services/Debug.cs",
    defs = "//service/Debug:ServiceDefinitions",
    service = "Debug",
)

test_suite(
    name = "test",
    tests = [
        ":client-localsocket",
        ":client-tcpip",
        ":communication-localsocket",
        ":communication-tcpip",
        ":unit",
    ],
    visibility = ["//:__pkg__"],
)

# The client end to end against a TestServer, once per transport it can reach one over.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":test-KRPC.Client",
)

client_test(
    name = "client-localsocket",
    size = "medium",
    server_executable = "//tools/TestServer",
    server_type = "localsocket",
    tags = ["local"],
    test_executable = ":test-KRPC.Client",
)

csharp_assembly_info(
    name = "TestAssemblyInfo",
    cls_compliant = False,
    copyright = author,
    title = "KRPC.Client.Test",
    version = assembly_version,
)

# CS1701: Google.Protobuf/Moq reference net5/6-era framework assemblies; unification
# handles this at runtime (MSBuild suppresses this warning by default). Matches the
# KRPC.Core targets.
test_nowarn = [
    "CS1591",
    "CS1573",
    "CS1685",
    "CS1701",
]

test_deps = [
    ":KRPC.Client.net8",
    "//tools/build/dotnet:Castle.Core",
    "//tools/build/dotnet:Google.Protobuf",
    "//tools/build/dotnet:Moq",
]

# What the client does regardless of the transport it talks over: encoding and decoding
# values, taking a message out of the blocks a read brings in, and naming a unix domain
# socket. It needs no server, so it runs on its own rather than under the harness that
# starts one.
csharp_nunit_test(
    name = "unit",
    size = "small",
    srcs = [
        "test/EncoderTest.cs",
        "test/MessageReaderTest.cs",
        "test/TestingTools.cs",
        "test/UnixEndPointTest.cs",
        ":TestAssemblyInfo",
        ":services-testservice",
    ],
    out = "KRPC.Client.Test.Unit",
    defines = ["CODE_ANALYSIS"],
    nowarn = test_nowarn,
    target_frameworks = ["net8.0"],
    deps = test_deps,
)

# The transport, one test each. Both run against a server the test listens on itself, which
# answers the handshake and every request after it, so neither needs a kRPC server. The
# bodies are shared and each transport supplies only how a connection is opened.
csharp_nunit_test(
    name = "communication-tcpip",
    size = "small",
    srcs = [
        "test/ConnectionTestCase.cs",
        "test/StandInServer.cs",
        "test/TCPIPConnectionTest.cs",
        ":TestAssemblyInfo",
    ],
    out = "KRPC.Client.Test.CommunicationTCPIP",
    defines = ["CODE_ANALYSIS"],
    nowarn = test_nowarn,
    tags = ["requires-network"],
    target_frameworks = ["net8.0"],
    deps = test_deps,
)

csharp_nunit_test(
    name = "communication-localsocket",
    size = "small",
    srcs = [
        "test/ConnectionTestCase.cs",
        "test/LocalSocketConnectionTest.cs",
        "test/StandInServer.cs",
        ":TestAssemblyInfo",
    ],
    out = "KRPC.Client.Test.CommunicationLocalSocket",
    defines = ["CODE_ANALYSIS"],
    nowarn = test_nowarn,
    target_frameworks = ["net8.0"],
    deps = test_deps,
)

csharp_nunit_test(
    name = "test-KRPC.Client",
    size = "small",
    srcs = [
        "test/ConnectionTest.cs",
        "test/EventTest.cs",
        "test/ObjectTest.cs",
        "test/ServerTestCase.cs",
        "test/StreamTest.cs",
        "test/TestingTools.cs",
        ":TestAssemblyInfo",
        ":services-testservice",
    ],
    out = "KRPC.Client.Test",
    defines = ["CODE_ANALYSIS"],
    nowarn = test_nowarn,
    tags = ["requires-network"],
    target_frameworks = ["net8.0"],
    visibility = ["//:__pkg__"],
    deps = test_deps,
)

# The benchmark program, run by //tools/benchmarks:csharp. Not a test: it measures.
csharp_binary(
    name = "benchmark",
    srcs = [
        "benchmark/Benchmark.cs",
        ":TestAssemblyInfo",
        ":services-testservice",
    ],
    # CS1701: Google.Protobuf references net5/6-era framework assemblies; unification handles
    # this at runtime. Matches the test target beside it.
    nowarn = [
        "CS1591",
        "CS1573",
        "CS1701",
    ],
    target_frameworks = ["net8.0"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [
        ":KRPC.Client.net8",
        "//tools/build/dotnet:Google.Protobuf",
    ],
)

clientgen_csharp(
    name = "services-testservice",
    out = "Services/TestService.cs",
    defs = "//tools/TestServer:ServiceDefinitions",
    service = "TestService",
    visibility = [
        "//:__pkg__",
    ],
)

# Sources for //:csproj-test, which checks them against the .csproj file lists.
filegroup(
    name = "csproj-srcs",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
    ]),
    visibility = ["//:__pkg__"],
)
