load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:config.bzl", "cmake_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:cog.bzl", "cog_test")
load("//tools/build:cpp.bzl", "clang_format_test", "clang_tidy_test")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build/protobuf:nanopb.bzl", "protobuf_nanopb")
load("//tools/krpctools:clientgen.bzl", "clientgen_cnano")

name = "krpc-cnano-%s" % version

pkg_zip(
    name = "cnano",
    out = "%s.zip" % name,
    files = glob([
        "include/**/*.h",
        "src/*.c",
        "cmake/*.cmake.in",
    ]) + [
        "CHANGELOG.md",
        "INSTALL.txt",
        "LICENSE",
        "README.txt",
        "src/krpc.options",
        ":cmake",
        ":protobuf",
        ":services-debug",
        ":services-dockingcamera",
        ":services-drawing",
        ":services-infernalrobotics",
        ":services-kerbalalarmclock",
        ":services-krpc",
        ":services-lidar",
        ":services-remotetech",
        ":services-spacecenter",
        ":services-stdlib",
        ":services-ui",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
        "//protobuf:krpc.proto",
    ],
    path_map = {
        "client/cnano/": "%s/" % name,
        "client/cnano/src/krpc.options": "%s/protobuf/krpc.options" % name,
        "COPYING": "%s/COPYING" % name,
        "COPYING.LESSER": "%s/COPYING.LESSER" % name,
        "VERSION.txt": "%s/VERSION.txt" % name,
        "protobuf/": "%s/protobuf/" % name,
    },
    visibility = ["//:__pkg__"],
)

genrule(
    name = "cmake",
    srcs = ["CMakeLists.txt.tmpl"],
    outs = ["CMakeLists.txt"],
    cmd = "sed 's/%VERSION%/" + cmake_version + '/g\' "$<" > "$@"',
)

clientgen_cnano(
    name = "services-krpc",
    out = "include/krpc_cnano/services/krpc.h",
    defs = "//core:ServiceDefinitions",
    service = "KRPC",
)

clientgen_cnano(
    name = "services-spacecenter",
    out = "include/krpc_cnano/services/space_center.h",
    defs = "//service/SpaceCenter:ServiceDefinitions",
    service = "SpaceCenter",
)

clientgen_cnano(
    name = "services-drawing",
    out = "include/krpc_cnano/services/drawing.h",
    defs = "//service/Drawing:ServiceDefinitions",
    service = "Drawing",
)

clientgen_cnano(
    name = "services-infernalrobotics",
    out = "include/krpc_cnano/services/infernal_robotics.h",
    defs = "//service/InfernalRobotics:ServiceDefinitions",
    service = "InfernalRobotics",
)

clientgen_cnano(
    name = "services-kerbalalarmclock",
    out = "include/krpc_cnano/services/kerbal_alarm_clock.h",
    defs = "//service/KerbalAlarmClock:ServiceDefinitions",
    service = "KerbalAlarmClock",
)

clientgen_cnano(
    name = "services-remotetech",
    out = "include/krpc_cnano/services/remote_tech.h",
    defs = "//service/RemoteTech:ServiceDefinitions",
    service = "RemoteTech",
)

clientgen_cnano(
    name = "services-ui",
    out = "include/krpc_cnano/services/ui.h",
    defs = "//service/UI:ServiceDefinitions",
    service = "UI",
)

clientgen_cnano(
    name = "services-stdlib",
    out = "include/krpc_cnano/services/stdlib.h",
    defs = "//core:StdLibServiceDefinitions",
    service = "StdLib",
)

clientgen_cnano(
    name = "services-lidar",
    out = "include/krpc_cnano/services/lidar.h",
    defs = "//service/LiDAR:ServiceDefinitions",
    service = "LiDAR",
)

clientgen_cnano(
    name = "services-dockingcamera",
    out = "include/krpc_cnano/services/dockingcamera.h",
    defs = "//service/DockingCamera:ServiceDefinitions",
    service = "DockingCamera",
)

clientgen_cnano(
    name = "services-debug",
    out = "include/krpc_cnano/services/debug.h",
    defs = "//service/Debug:ServiceDefinitions",
    service = "Debug",
)

clientgen_cnano(
    name = "services-test-service",
    out = "test/services/test_service.h",
    defs = "//tools/TestServer:ServiceDefinitions",
    service = "TestService",
)

srcs = glob(["src/**/*.c"])

hdrs = glob(["include/**/*.h"]) + [
    ":services-krpc",
    ":services-spacecenter",
    ":services-drawing",
    ":services-infernalrobotics",
    ":services-kerbalalarmclock",
    ":services-remotetech",
    ":services-stdlib",
        ":services-ui",
    ":services-lidar",
    ":services-debug",
    ":services-dockingcamera",
]

cc_library(
    name = "krpc_cnano",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@c_nanopb//:nanopb"],
)

test_suite(
    name = "test",
    tests = [
        ":client-localsocket",
        ":client-serialio",
        ":client-tcpip",
        ":cog",
        ":communication-arduino",
        ":communication-localsocket",
        ":communication-serialio",
        ":communication-tcpip",
        ":lint",
        ":unit",
    ],
)

# The encoder and decoder sources contain cog generator blocks whose expansion is
# committed to the tree; this checks it was regenerated after any edit to them.
cog_test(
    name = "cog",
    size = "small",
    srcs = [
        "include/krpc_cnano/decoder.h",
        "include/krpc_cnano/encoder.h",
        "src/decoder.c",
        "src/encoder.c",
    ],
)

# The library built for each of the transports that can be tested here. They all enable server
# error messages, so that the tests cover decoding them and a failure says what the server
# objected to; the default build, with them disabled, is covered by the krpc_cnano library itself.
# The socket ones are not testonly, as a benchmark program is built on each of them too.
cc_library(
    name = "krpc_cnano_serialio",
    testonly = True,
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = ["KRPC_ERROR_MESSAGES"],
    includes = ["include"],
    deps = ["@c_nanopb//:nanopb"],
)

cc_library(
    name = "krpc_cnano_tcpip",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_TCP",
        "KRPC_ERROR_MESSAGES",
    ],
    includes = ["include"],
    # The sockets are winsock's on Windows, which is a library of its own rather
    # than part of the C runtime.
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    deps = ["@c_nanopb//:nanopb"],
)

cc_library(
    name = "krpc_cnano_localsocket",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_LOCALSOCKET",
        "KRPC_ERROR_MESSAGES",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    deps = ["@c_nanopb//:nanopb"],
)

# What the client does regardless of the transport it talks over: encoding and decoding values
# and messages. It needs no server, so it runs on its own rather than under the harness that
# starts one, and it is built for one transport rather than every one of them.
cc_test(
    name = "unit",
    size = "small",
    srcs = [
        "test/test_decoder.cpp",
        "test/test_encode_decode.cpp",
        "test/test_encoder.cpp",
        "test/test_utils.cpp",
        "test/testing_tools.hpp",
        ":services-test-service",
    ],
    includes = ["test"],
    deps = [
        ":krpc_cnano_serialio",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The communication backends, one test each. Every one of them runs against something that
# behaves as the thing it talks to does, so none needs the hardware, port or server it is
# written for. The serial backend has a source per platform, POSIX and Windows being separate
# implementations of it.
cc_test(
    name = "communication-serialio",
    size = "small",
    srcs = [
        "test/test_communication_posix.cpp",
        "test/test_communication_windows.cpp",
    ],
    deps = [
        ":krpc_cnano_serialio",
        "@cpp_googletest//:gtest",
    ],
)

cc_test(
    name = "communication-tcpip",
    size = "small",
    srcs = ["test/test_communication_socket.cpp"],
    deps = [
        ":krpc_cnano_tcpip",
        "@cpp_googletest//:gtest",
    ],
)

# Builds the Arduino communication backend for the host, against a stand-in for the Arduino
# HardwareSerial class, so it can be tested without hardware. It deliberately does not depend
# on krpc_cnano, whose copy of communication.c is built for the host platform instead and
# defines the same functions.
cc_test(
    name = "communication-arduino",
    size = "small",
    srcs = [
        "include/krpc_cnano/communication.h",
        "include/krpc_cnano/error.h",
        "src/communication.c",
        "test/arduino/HardwareSerial.h",
        "test/arduino/test_communication_arduino.cpp",
    ],
    # communication.c is C, but the Arduino backend it holds is C++ and the header
    # says so. Compile it as C++, spelled for the active compiler.
    copts = select({
        "@platforms//os:windows": ["/TP"],
        "//conditions:default": ["-xc++"],
    }),
    includes = [
        "include",
        "test/arduino",
    ],
    local_defines = ["ARDUINO"],
    deps = ["@cpp_googletest//:gtest"],
)

# Builds the library for a unix domain socket, together with the tests it shares with the other
# socket transport, and exercises it against a socket the test itself listens on.
cc_test(
    name = "communication-localsocket",
    size = "small",
    srcs = [
        "test/test_communication_localsocket.cpp",
        "test/test_communication_socket.cpp",
    ],
    deps = [
        ":krpc_cnano_localsocket",
        "@cpp_googletest//:gtest",
    ],
)

# The client end to end against a TestServer, once per transport. They differ in more than the
# socket: a serial port carries both of the connections to a server over the one link, so its
# messages are wrapped in a multiplexed message saying which they belong to, where a transport
# that opens a connection per server sends the messages themselves.
client_test(
    name = "client-serialio",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "serialio",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":cnanotest-serialio",
)

client_test(
    name = "client-tcpip",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "protobuf",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":cnanotest-tcpip",
)

# And again over a unix domain socket. The framing is the one TCP/IP uses, so what this adds is
# the client reaching a server the way that transport does, against a server serving it.
client_test(
    name = "client-localsocket",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "localsocket",
    tags = ["local"],
    test_executable = ":cnanotest-localsocket",
)

client_test_srcs = [
    "test/server_test.hpp",
    "test/test_client.cpp",
    ":services-test-service",
]

cc_binary(
    name = "cnanotest-serialio",
    testonly = True,
    srcs = client_test_srcs,
    includes = ["test"],
    deps = [
        ":krpc_cnano_serialio",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

cc_binary(
    name = "cnanotest-tcpip",
    testonly = True,
    srcs = client_test_srcs,
    includes = ["test"],
    deps = [
        ":krpc_cnano_tcpip",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

cc_binary(
    name = "cnanotest-localsocket",
    testonly = True,
    srcs = client_test_srcs,
    includes = ["test"],
    deps = [
        ":krpc_cnano_localsocket",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The benchmark program, run by //tools/benchmarks:cnano. Not a test: it measures. One per
# transport, since this client is compiled for the one it talks over rather than choosing when
# it connects, and the runner measures both.
cc_binary(
    name = "benchmark",
    srcs = [
        "benchmark/benchmark.c",
        ":services-test-service",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc_cnano_tcpip"],
)

cc_binary(
    name = "benchmark-localsocket",
    srcs = [
        "benchmark/benchmark.c",
        ":services-test-service",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc_cnano_localsocket"],
)

test_suite(
    name = "lint",
    tests = [
        ":clangformat",
        ":clangtidy",
    ],
)

clang_tidy_test(
    name = "clangtidy",
    size = "large",
    srcs = srcs,
    copts = ["-std=c99"],
    deps = [":krpc_cnano"],
)

clang_format_test(
    name = "clangformat",
    size = "small",
    srcs = glob([
        "benchmark/*.c",
        "src/*.c",
        "include/**/*.h",
        "test/**/*.cpp",
        "test/**/*.hpp",
    ]),
)

#TODO: use targets in //protobuf:... instead of the following
protobuf_nanopb(
    name = "protobuf",
    src = "//protobuf:krpc.proto",
    include = "krpc_cnano",
    header = "include/krpc_cnano/krpc.pb.h",
    options = "src/krpc.options",
    source = "src/krpc.pb.c",
)

exports_files([
    "CHANGELOG.md",
    "src/krpc.options",
])
