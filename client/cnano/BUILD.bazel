load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:config.bzl", "cmake_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:cog.bzl", "cog_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:cpp.bzl", "cc_deprecation_signals", "clang_format_test", "clang_tidy_test", "doxygen_test")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build/protobuf:nanopb.bzl", "protobuf_nanopb")
load("//tools/krpctools:clientgen.bzl", "clientgen_dispatch", "clientgen_services")

services = clientgen_services(
    "cnano",
    outs = {"TestService": "test/services/test_service.h"},
)

name = "krpc-cnano-%s" % version

pkg_zip(
    name = "cnano",
    out = "%s.zip" % name,
    files = glob([
        "include/**/*.h",
        "src/*.c",
        "cmake/*.cmake.in",
    ]) + [
        "CHANGELOG.md",
        "INSTALL.txt",
        "LICENSE",
        "README.txt",
        "src/krpc.options",
        ":cmake",
        ":protobuf",
        "//:version",
        "//protobuf:krpc.proto",
    ] + services,
    path_map = {
        "client/cnano/": "%s/" % name,
        "client/cnano/src/krpc.options": "%s/protobuf/krpc.options" % name,
        "VERSION.txt": "%s/VERSION.txt" % name,
        "protobuf/": "%s/protobuf/" % name,
    },
    visibility = ["//:__pkg__"],
)

genrule(
    name = "cmake",
    srcs = ["CMakeLists.txt.tmpl"],
    outs = ["CMakeLists.txt"],
    cmd = "sed 's/%VERSION%/" + cmake_version + '/g\' "$<" > "$@"',
)

srcs = glob(["src/**/*.c"])

hdrs = glob(["include/**/*.h"]) + services

# Winsock is a library of its own on Windows, not part of the C runtime
ws2_32 = select({
    "@platforms//os:windows": ["ws2_32.lib"],
    "//conditions:default": [],
})

cc_library(
    name = "krpc_cnano",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    includes = ["include"],
    linkopts = ws2_32,
    visibility = ["//visibility:public"],
    deps = ["@c_nanopb//:nanopb"],
)

# The library with server error messages, for the tests, so that they cover decoding them and a
# failure says what the server objected to, and for the benchmark
cc_library(
    name = "krpc_cnano_error_messages",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = ["KRPC_ERROR_MESSAGES"],
    includes = ["include"],
    linkopts = ws2_32,
    deps = ["@c_nanopb//:nanopb"],
)

test_suite(
    name = "test",
    tests = [
        ":client-tcpip",
        ":cog",
        ":communication-arduino",
        ":communication-serialio",
        ":communication-socket",
        ":communication-transport",
        ":conformance",
        ":doxygen",
        ":lint",
        ":memory",
    ],
)

# The encoder and decoder sources contain cog generator blocks whose expansion is
# committed to the tree; this checks it was regenerated after any edit to them.
cog_test(
    name = "cog",
    size = "small",
    srcs = [
        "include/krpc_cnano/decoder.h",
        "include/krpc_cnano/encoder.h",
        "src/decoder.c",
        "src/encoder.c",
    ],
)

# The transports, for what the conformance tests do not reach. Each runs against something that
# behaves as the thing it talks to does, so none needs the hardware, port or server it is written
# for. The serial conformance tests run on Linux only, so the Windows serial transport is tested
# here.
cc_test(
    name = "communication-serialio",
    size = "small",
    srcs = ["test/test_windows.cpp"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":krpc_cnano_error_messages",
        "@cpp_googletest//:gtest",
    ],
)

cc_test(
    name = "communication-socket",
    size = "small",
    srcs = ["test/test_socket.cpp"],
    tags = ["requires-network"],
    deps = [
        ":krpc_cnano_error_messages",
        "@cpp_googletest//:gtest",
    ],
)

# A transport the program supplies
cc_test(
    name = "communication-transport",
    size = "small",
    srcs = ["test/test_transport.cpp"],
    deps = [
        ":krpc_cnano_error_messages",
        "@cpp_googletest//:gtest",
    ],
)

# The library with an allocator a test supplies
cc_library(
    name = "krpc_cnano_custom_memory",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = ["KRPC_CUSTOM_MEMORY_ALLOC"],
    includes = ["include"],
    linkopts = ws2_32,
    deps = ["@c_nanopb//:nanopb"],
)

# Heap use, with an allocator that counts blocks and can fail an allocation
cc_test(
    name = "memory",
    size = "small",
    srcs = [
        "test/memory.cpp",
        "test/memory.h",
        "test/test_procedure_call.cpp",
    ],
    deps = [
        ":krpc_cnano_custom_memory",
        "@cpp_googletest//:gtest",
    ],
)

# Builds the Arduino stream transport for the host, against a stand-in for the Arduino core, so
# it can be tested without hardware. It does not depend on krpc_cnano, whose transports are built
# for the host platform instead.
cc_test(
    name = "communication-arduino",
    size = "small",
    srcs = [
        "include/krpc_cnano/communication.h",
        "include/krpc_cnano/error.h",
        "src/communication.c",
        "src/stream.c",
        "test/Arduino.h",
        "test/test_arduino.cpp",
    ],
    # The Arduino build is C++, so the sources are compiled as C++, spelled for the active
    # compiler
    copts = select({
        "@platforms//os:windows": ["/TP"],
        "//conditions:default": ["-xc++"],
    }),
    includes = [
        "include",
        "test",
    ],
    local_defines = ["ARDUINO"],
    deps = ["@cpp_googletest//:gtest"],
)

# The compiler's warnings for a use of each deprecated member, for the testee to report
cc_library(
    name = "conformance-stub-headers",
    testonly = True,
    hdrs = [
        "conformance/services/deprecated_service.h",
        ":services-testservice",
    ],
    includes = [
        "conformance",
        "test",
    ],
    deps = [":krpc_cnano_error_messages"],
)

cc_deprecation_signals(
    name = "conformance-deprecation-signals",
    testonly = True,
    src = "conformance/deprecation_uses.c",
    out = "conformance/deprecation_signals.hpp",
    # MSVC has no enumeration value attribute in C
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/TP"],
        "//conditions:default": [],
    }),
    cxx = select({
        "@rules_cc//cc/compiler:msvc-cl": True,
        "//conditions:default": False,
    }),
    deps = [":conformance-stub-headers"],
)

# The conformance tests, driving the client through its testee over each transport
cc_binary(
    name = "conformance-testee",
    testonly = True,
    srcs = [
        "conformance/codec.hpp",
        "conformance/dispatch_values.hpp",
        "conformance/framing.hpp",
        "conformance/main.cpp",
        ":conformance-deprecation-signals",
        ":services-testservice",
    ] + clientgen_dispatch(
        out = "conformance/{snake_service}_dispatch.hpp",
        language = "cnano",
        services_out = "conformance/services/{snake_service}.h",
    ),
    # The dispatch calls the deprecated TestService members
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/wd4996"],
        "//conditions:default": ["-Wno-deprecated-declarations"],
    }),
    includes = [
        "conformance",
        "test",
    ],
    deps = [
        ":krpc_cnano_error_messages",
        "//client/conformance:testee-cpp",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "functions",
    ],
    protocols = [
        "tcpip",
        "localsocket",
        "serialio",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

# The client's own API against a TestServer. The conformance tests cover each transport, so
# this runs over one.
client_test(
    name = "client-tcpip",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "protobuf",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":cnanotest-tcpip",
)

cc_binary(
    name = "cnanotest-tcpip",
    testonly = True,
    srcs = ["test/test_client.cpp"],
    deps = [
        ":krpc_cnano_error_messages",
        "@cpp_googletest//:gtest",
    ],
)

# The benchmark program, run by //tools/benchmarks:cnano. Not a test: it measures.
cc_binary(
    name = "benchmark",
    srcs = [
        "benchmark/benchmark.c",
        ":services-testservice",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc_cnano_error_messages"],
)

# The program the CMake and vcpkg CI scripts build against the installed package, built here
# so that it is linted
cc_binary(
    name = "test-consumer",
    srcs = ["test-consumer/main.c"],
    deps = [":krpc_cnano"],
)

test_suite(
    name = "lint",
    tests = [
        ":clangformat",
        ":clangtidy",
    ],
)

# The Windows serial transport test builds on Windows alone, where clang-tidy does not run
clang_tidy_test(
    name = "clangtidy",
    size = "large",
    conlyopts = ["-std=c99"],
    programs = [
        ":benchmark",
        ":cnanotest-tcpip",
        ":communication-arduino",
        ":communication-socket",
        ":communication-transport",
        ":conformance-testee",
        ":memory",
        ":test-consumer",
    ],
    targets = [
        ":krpc_cnano",
        ":krpc_cnano_error_messages",
    ],
)

clang_format_test(
    name = "clangformat",
    size = "small",
    srcs = glob([
        "conformance/*.cpp",
        "conformance/*.hpp",
        "benchmark/*.c",
        "src/*.c",
        "test-consumer/*.c",
        "include/**/*.h",
        "test/*.cpp",
        "test/*.h",
    ]),
)

#TODO: use targets in //protobuf:... instead of the following
protobuf_nanopb(
    name = "protobuf",
    src = "//protobuf:krpc.proto",
    include = "krpc_cnano",
    header = "include/krpc_cnano/krpc.pb.h",
    options = "src/krpc.options",
    source = "src/krpc.pb.c",
)

exports_files([
    "CHANGELOG.md",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

# The documentation of the client and of the test service, which exercises every form the
# documentation takes, as Doxygen reads it. Doxygen on Linux links no static function from
# another header, and every function of the client is static.
doxygen_test(
    name = "doxygen",
    size = "small",
    srcs = hdrs + [":services-testservice"],
    c = True,
    unlinked = [
        "krpc_KRPC_Expression_Call()",
        "krpc_KRPC_GameScene()",
        "krpc_SpaceCenter_Vessel_Position()",
        "krpc_SpaceCenter_Vessel_Velocity()",
    ],
)
