load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:config.bzl", "cmake_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:cog.bzl", "cog_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:cpp.bzl", "clang_format_test", "clang_tidy_test", "doxygen_test")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build/protobuf:nanopb.bzl", "protobuf_nanopb")
load("//tools/krpctools:clientgen.bzl", "clientgen_dispatch", "clientgen_services")

services = clientgen_services(
    "cnano",
    outs = {"TestService": "test/services/test_service.h"},
)

name = "krpc-cnano-%s" % version

pkg_zip(
    name = "cnano",
    out = "%s.zip" % name,
    files = glob([
        "include/**/*.h",
        "src/*.c",
        "cmake/*.cmake.in",
    ]) + [
        "CHANGELOG.md",
        "INSTALL.txt",
        "LICENSE",
        "README.txt",
        "src/krpc.options",
        ":cmake",
        ":protobuf",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
        "//protobuf:krpc.proto",
    ] + services,
    path_map = {
        "client/cnano/": "%s/" % name,
        "client/cnano/src/krpc.options": "%s/protobuf/krpc.options" % name,
        "COPYING": "%s/COPYING" % name,
        "COPYING.LESSER": "%s/COPYING.LESSER" % name,
        "VERSION.txt": "%s/VERSION.txt" % name,
        "protobuf/": "%s/protobuf/" % name,
    },
    visibility = ["//:__pkg__"],
)

genrule(
    name = "cmake",
    srcs = ["CMakeLists.txt.tmpl"],
    outs = ["CMakeLists.txt"],
    cmd = "sed 's/%VERSION%/" + cmake_version + '/g\' "$<" > "$@"',
)

srcs = glob(["src/**/*.c"])

hdrs = glob(["include/**/*.h"]) + services

cc_library(
    name = "krpc_cnano",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@c_nanopb//:nanopb"],
)

test_suite(
    name = "test",
    tests = [
        ":client-tcpip",
        ":cog",
        ":communication-arduino",
        ":communication-localsocket",
        ":communication-serialio",
        ":communication-tcpip",
        ":conformance",
        ":doxygen",
        ":lint",
    ],
)

# The encoder and decoder sources contain cog generator blocks whose expansion is
# committed to the tree; this checks it was regenerated after any edit to them.
cog_test(
    name = "cog",
    size = "small",
    srcs = [
        "include/krpc_cnano/decoder.h",
        "include/krpc_cnano/encoder.h",
        "src/decoder.c",
        "src/encoder.c",
    ],
)

# The library built for each of the transports that can be tested here. They all enable server
# error messages, so that the tests cover decoding them and a failure says what the server
# objected to; the default build, with them disabled, is covered by the krpc_cnano library itself.
# The socket ones are not testonly, as a benchmark program is built on each of them too.
cc_library(
    name = "krpc_cnano_serialio",
    testonly = True,
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_ERROR_MESSAGES",
        "KRPC_WRITE_FAULTS",
    ],
    includes = ["include"],
    deps = ["@c_nanopb//:nanopb"],
)

cc_library(
    name = "krpc_cnano_tcpip",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_TCP",
        "KRPC_ERROR_MESSAGES",
    ],
    includes = ["include"],
    # The sockets are winsock's on Windows, which is a library of its own rather
    # than part of the C runtime.
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//doc:__pkg__"],
    deps = ["@c_nanopb//:nanopb"],
)

cc_library(
    name = "krpc_cnano_localsocket",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_LOCALSOCKET",
        "KRPC_ERROR_MESSAGES",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//doc:__pkg__"],
    deps = ["@c_nanopb//:nanopb"],
)

# The socket libraries with the write fault compiled in, for the conformance testees
cc_library(
    name = "krpc_cnano_tcpip_testee",
    testonly = True,
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_TCP",
        "KRPC_ERROR_MESSAGES",
        "KRPC_WRITE_FAULTS",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    deps = ["@c_nanopb//:nanopb"],
)

cc_library(
    name = "krpc_cnano_localsocket_testee",
    testonly = True,
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = [
        "KRPC_COMMUNICATION_LOCALSOCKET",
        "KRPC_ERROR_MESSAGES",
        "KRPC_WRITE_FAULTS",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    deps = ["@c_nanopb//:nanopb"],
)

# The communication backends, for what the conformance tests do not reach. Every one of them
# runs against something that behaves as the thing it talks to does, so none needs the
# hardware, port or server it is written for. The serial conformance tests run on Linux only,
# so the Windows serial backend is tested here.
cc_test(
    name = "communication-serialio",
    size = "small",
    srcs = ["test/test_windows.cpp"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":krpc_cnano_serialio",
        "@cpp_googletest//:gtest",
    ],
)

cc_test(
    name = "communication-tcpip",
    size = "small",
    srcs = ["test/test_socket.cpp"],
    deps = [
        ":krpc_cnano_tcpip",
        "@cpp_googletest//:gtest",
    ],
)

# Builds the Arduino communication backend for the host, against a stand-in for the Arduino
# HardwareSerial class, so it can be tested without hardware. It deliberately does not depend
# on krpc_cnano, whose copy of communication.c is built for the host platform instead and
# defines the same functions.
cc_test(
    name = "communication-arduino",
    size = "small",
    srcs = [
        "include/krpc_cnano/communication.h",
        "include/krpc_cnano/error.h",
        "src/communication.c",
        "test/HardwareSerial.h",
        "test/test_arduino.cpp",
    ],
    # communication.c is C, but the Arduino backend it holds is C++ and the header
    # says so. Compile it as C++, spelled for the active compiler.
    copts = select({
        "@platforms//os:windows": ["/TP"],
        "//conditions:default": ["-xc++"],
    }),
    includes = [
        "include",
        "test",
    ],
    local_defines = ["ARDUINO"],
    deps = ["@cpp_googletest//:gtest"],
)

# The library built for a unix domain socket, with the tests it shares with the other socket
# transport.
cc_test(
    name = "communication-localsocket",
    size = "small",
    srcs = ["test/test_socket.cpp"],
    deps = [
        ":krpc_cnano_localsocket",
        "@cpp_googletest//:gtest",
    ],
)

# The conformance tests, driving the client through its testee. The library is built for one
# transport, so there is a testee for each.
conformance_testee_srcs = [
    "conformance/codec.hpp",
    "conformance/dispatch_values.hpp",
    "conformance/framing.hpp",
    "conformance/main.cpp",
    ":services-testservice",
] + clientgen_dispatch(
    out = "conformance/{snake_service}_dispatch.hpp",
    language = "cnano",
    services_out = "conformance/services/{snake_service}.h",
)

# The dispatch calls the deprecated TestService members
conformance_testee_copts = select({
    "@rules_cc//cc/compiler:msvc-cl": ["/wd4996"],
    "//conditions:default": ["-Wno-deprecated-declarations"],
})

cc_binary(
    name = "conformance-testee",
    testonly = True,
    srcs = conformance_testee_srcs,
    copts = conformance_testee_copts,
    includes = [
        "conformance",
        "test",
    ],
    deps = [
        ":krpc_cnano_tcpip_testee",
        "//client/conformance:testee-cpp",
    ],
)

cc_binary(
    name = "conformance-testee-serialio",
    testonly = True,
    srcs = conformance_testee_srcs,
    copts = conformance_testee_copts,
    includes = [
        "conformance",
        "test",
    ],
    deps = [
        ":krpc_cnano_serialio",
        "//client/conformance:testee-cpp",
    ],
)

cc_binary(
    name = "conformance-testee-localsocket",
    testonly = True,
    srcs = conformance_testee_srcs,
    copts = conformance_testee_copts,
    includes = [
        "conformance",
        "test",
    ],
    deps = [
        ":krpc_cnano_localsocket_testee",
        "//client/conformance:testee-cpp",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    expected_failures = "conformance/expected-failures.txt",
    profiles = ["core"],
    protocol_testees = {
        "localsocket": ":conformance-testee-localsocket",
        "serialio": ":conformance-testee-serialio",
    },
    protocols = [
        "tcpip",
        "localsocket",
        "serialio",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

# The client's own API against a TestServer. The conformance tests cover each transport, so
# this runs over one.
client_test(
    name = "client-tcpip",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "protobuf",
    tags = [
        "local",
        "requires-network",
    ],
    test_executable = ":cnanotest-tcpip",
)

cc_binary(
    name = "cnanotest-tcpip",
    testonly = True,
    srcs = ["test/test_client.cpp"],
    deps = [
        ":krpc_cnano_tcpip",
        "@cpp_googletest//:gtest",
    ],
)

# The benchmark program, run by //tools/benchmarks:cnano. Not a test: it measures. One per
# transport, since this client is compiled for the one it talks over rather than choosing when
# it connects, and the runner measures both.
cc_binary(
    name = "benchmark",
    srcs = [
        "benchmark/benchmark.c",
        ":services-testservice",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc_cnano_tcpip"],
)

cc_binary(
    name = "benchmark-localsocket",
    srcs = [
        "benchmark/benchmark.c",
        ":services-testservice",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc_cnano_localsocket"],
)

test_suite(
    name = "lint",
    tests = [
        ":clangformat",
        ":clangtidy",
    ],
)

clang_tidy_test(
    name = "clangtidy",
    size = "large",
    srcs = srcs,
    copts = ["-std=c99"],
    deps = [":krpc_cnano"],
)

clang_format_test(
    name = "clangformat",
    size = "small",
    srcs = glob([
        "conformance/*.cpp",
        "conformance/*.hpp",
        "benchmark/*.c",
        "src/*.c",
        "include/**/*.h",
        "test/*.cpp",
        "test/*.h",
    ]),
)

#TODO: use targets in //protobuf:... instead of the following
protobuf_nanopb(
    name = "protobuf",
    src = "//protobuf:krpc.proto",
    include = "krpc_cnano",
    header = "include/krpc_cnano/krpc.pb.h",
    options = "src/krpc.options",
    source = "src/krpc.pb.c",
)

exports_files([
    "CHANGELOG.md",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

# The documentation of the client and of the test service, which exercises every form the
# documentation takes, as Doxygen reads it. Doxygen on Linux links no static function from
# another header, and every function of the client is static.
doxygen_test(
    name = "doxygen",
    size = "small",
    srcs = hdrs + [":services-testservice"],
    c = True,
    unlinked = [
        "krpc_KRPC_GameScene()",
        "krpc_SpaceCenter_Vessel_Position()",
        "krpc_SpaceCenter_Vessel_Velocity()",
    ],
)
