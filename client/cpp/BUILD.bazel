load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:config.bzl", "cmake_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:cpp.bzl", "clang_format_test", "clang_tidy_test", "doxygen_test")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build/protobuf:cpp.bzl", "protobuf_cpp")
load("//tools/krpctools:clientgen.bzl", "clientgen_dispatch", "clientgen_services")

exports_files([
    "CHANGELOG.md",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

services = clientgen_services(
    "cpp",
    outs = {"TestService": "test/services/test_service.hpp"},
)

name = "krpc-cpp-%s" % version

pkg_zip(
    name = "cpp",
    out = "%s.zip" % name,
    files = glob([
        "include/**/*.hpp",
        "src/*.cpp",
        "cmake/*.cmake",
        "cmake/*.cmake.in",
    ]) + [
        "CHANGELOG.md",
        "INSTALL.txt",
        "LICENSE",
        "README.txt",
        ":cmake",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
        "//protobuf:krpc.proto",
    ] + services,
    path_map = {
        "client/cpp/": "%s/" % name,
        "COPYING": "%s/COPYING" % name,
        "COPYING.LESSER": "%s/COPYING.LESSER" % name,
        "VERSION.txt": "%s/VERSION.txt" % name,
        "protobuf/": "%s/protobuf/" % name,
    },
    visibility = ["//:__pkg__"],
)

genrule(
    name = "cmake",
    srcs = ["CMakeLists.txt.tmpl"],
    outs = ["CMakeLists.txt"],
    cmd = "sed 's/%VERSION%/" + cmake_version + '/g\' "$<" > "$@"',
)

srcs = glob(["src/*.cpp"])

hdrs = glob(["include/**/*.hpp"]) + services

cc_library(
    name = "krpc",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@cpp_asio//:asio",
        "@protobuf//:protobuf_lite",
    ],
)

# The client with its race points compiled in, for the conformance testee
cc_library(
    name = "krpc-race-points",
    testonly = True,
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    defines = ["KRPC_RACE_POINTS"],
    includes = ["include"],
    deps = [
        "@cpp_asio//:asio",
        "@protobuf//:protobuf_lite",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":client-tcpip",
        ":conformance",
        ":doxygen",
        ":lint",
        ":unit",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":clangformat",
        ":clangtidy",
    ],
)

# What the client does without a server: the locks streams use, and hashing. It needs no
# server, so it runs on its own, outside the harness that starts one.
cc_test(
    name = "unit",
    size = "small",
    srcs = [
        "test/test_condition.cpp",
        "test/test_hash.cpp",
        ":services-testservice",
    ],
    includes = ["test"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The client's own API against a TestServer. The conformance tests cover each transport, so
# this runs over one.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":cpptest",
)

test_srcs = [
    "test/test_client.cpp",
    "test/test_event.cpp",
    "test/test_function_stream.cpp",
    "test/test_stream.cpp",
    ":services-testservice",
    "test/server_test.hpp",
]

cc_binary(
    name = "cpptest",
    testonly = True,
    srcs = test_srcs,
    includes = ["test"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The benchmark program, run by //tools/benchmarks:cpp. Not a test: it measures.
cc_binary(
    name = "benchmark",
    srcs = [
        "benchmark/benchmark.cpp",
        ":services-testservice",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc"],
)

# The conformance tests, driving the client through its testee
cc_binary(
    name = "conformance-testee",
    testonly = True,
    srcs = [
        "conformance/codec.hpp",
        "conformance/dispatch_values.hpp",
        "conformance/framing.hpp",
        "conformance/functions.hpp",
        "conformance/main.cpp",
        ":services-testservice",
    ] + clientgen_dispatch(
        out = "conformance/{snake_service}_dispatch.hpp",
        language = "cpp",
        services_out = "conformance/services/{snake_service}.hpp",
    ),
    # The dispatch calls the deprecated TestService members
    copts = ["-Wno-deprecated-declarations"],
    includes = [
        "conformance",
        "test",
    ],
    deps = [
        ":krpc-race-points",
        "//client/conformance:testee-cpp",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    conventions = "conformance/conventions.json",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "error-types",
        "defaults",
        "streams",
        "events",
        "functions",
        "function-types",
        "connections",
        "threads",
        "callbacks",
        "conditions",
        "ordering",
        "races",
    ],
    protocols = [
        "tcpip",
        "localsocket",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

clang_tidy_test(
    name = "clangtidy",
    size = "large",
    srcs = srcs,
    copts = [
        "-std=c++17",
        "-stdlib=libc++",
        "-Wno-unused-command-line-argument",
    ],
    deps = [":krpc"],
)

clang_format_test(
    name = "clangformat",
    size = "small",
    srcs = glob([
        "conformance/*.cpp",
        "conformance/*.hpp",
        "src/*.cpp",
        "include/**/*.hpp",
        "test/**/*.cpp",
        "test/**/*.hpp",
    ]),
)

#TODO: use targets in //protobuf:... instead of the following
protobuf_cpp(
    name = "protobuf",
    src = "//protobuf:krpc.proto",
    include = "krpc/krpc.pb.hpp",
    header = "include/krpc/krpc.pb.hpp",
    source = "src/krpc.pb.cpp",
)

# The documentation of the client and of the test service, which exercises every form the
# documentation takes, as Doxygen reads it
doxygen_test(
    name = "doxygen",
    size = "small",
    srcs = hdrs + [":services-testservice"],
)
