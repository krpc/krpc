load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:config.bzl", "cmake_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:cpp.bzl", "clang_format_test", "clang_tidy_test")
load("//tools/build:pkg.bzl", "pkg_zip")
load("//tools/build/protobuf:cpp.bzl", "protobuf_cpp")
load("//tools/krpctools:clientgen.bzl", "clientgen_services")

exports_files(["CHANGELOG.md"])

services = clientgen_services(
    "cpp",
    outs = {"TestService": "test/services/test_service.hpp"},
)

name = "krpc-cpp-%s" % version

pkg_zip(
    name = "cpp",
    out = "%s.zip" % name,
    files = glob([
        "include/**/*.hpp",
        "src/*.cpp",
        "cmake/*.cmake",
        "cmake/*.cmake.in",
    ]) + [
        "CHANGELOG.md",
        "INSTALL.txt",
        "LICENSE",
        "README.txt",
        ":cmake",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
        "//protobuf:krpc.proto",
    ] + services,
    path_map = {
        "client/cpp/": "%s/" % name,
        "COPYING": "%s/COPYING" % name,
        "COPYING.LESSER": "%s/COPYING.LESSER" % name,
        "VERSION.txt": "%s/VERSION.txt" % name,
        "protobuf/": "%s/protobuf/" % name,
    },
    visibility = ["//:__pkg__"],
)

genrule(
    name = "cmake",
    srcs = ["CMakeLists.txt.tmpl"],
    outs = ["CMakeLists.txt"],
    cmd = "sed 's/%VERSION%/" + cmake_version + '/g\' "$<" > "$@"',
)

srcs = glob(["src/*.cpp"])

hdrs = glob(["include/**/*.hpp"]) + services

cc_library(
    name = "krpc",
    srcs = srcs + [":protobuf"],
    hdrs = hdrs + [":protobuf"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@cpp_asio//:asio",
        "@protobuf//:protobuf_lite",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":client-localsocket",
        ":client-tcpip",
        ":communication-localsocket",
        ":communication-tcpip",
        ":lint",
        ":unit",
    ],
)

test_suite(
    name = "lint",
    tests = [
        ":clangformat",
        ":clangtidy",
    ],
)

# What the client does regardless of the transport it talks over: encoding and decoding
# values and messages, and the locks streams use. It needs no server, so it runs on its own,
# outside the harness that starts one.
cc_test(
    name = "unit",
    size = "small",
    srcs = [
        "test/test_condition.cpp",
        "test/test_decoder.cpp",
        "test/test_encode_decode.cpp",
        "test/test_encoder.cpp",
        "test/test_hash.cpp",
        ":services-testservice",
    ],
    includes = ["test"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The transport, one test each. Both run against a server the test listens on itself, so
# neither needs a kRPC server. The bodies are shared and instantiated once per transport,
# as only opening the connection differs between them.
cc_test(
    name = "communication-tcpip",
    size = "small",
    srcs = [
        "test/connection_test.hpp",
        "test/test_connection_tcpip.cpp",
    ],
    includes = ["test"],
    tags = ["requires-network"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gtest",
    ],
)

cc_test(
    name = "communication-localsocket",
    size = "small",
    srcs = [
        "test/connection_test.hpp",
        "test/test_connection_localsocket.cpp",
    ],
    includes = ["test"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gtest",
    ],
)

# The client end to end against a TestServer, once per transport it can reach one over.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":cpptest",
)

client_test(
    name = "client-localsocket",
    size = "medium",
    server_executable = "//tools/TestServer",
    server_type = "localsocket",
    test_executable = ":cpptest",
)

test_srcs = [
    "test/test_client.cpp",
    "test/test_event.cpp",
    "test/test_function_stream.cpp",
    "test/test_object.cpp",
    "test/test_services.cpp",
    "test/test_stream.cpp",
    ":services-testservice",
    "test/server_test.hpp",
]

cc_binary(
    name = "cpptest",
    testonly = True,
    srcs = test_srcs,
    includes = ["test"],
    deps = [
        ":krpc",
        "@cpp_googletest//:gmock",
        "@cpp_googletest//:gtest",
    ],
)

# The benchmark program, run by //tools/benchmarks:cpp. Not a test: it measures.
cc_binary(
    name = "benchmark",
    srcs = [
        "benchmark/benchmark.cpp",
        ":services-testservice",
    ],
    includes = ["test"],
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = [":krpc"],
)

clang_tidy_test(
    name = "clangtidy",
    size = "large",
    srcs = srcs,
    copts = [
        "-std=c++17",
        "-stdlib=libc++",
        "-Wno-unused-command-line-argument",
    ],
    deps = [":krpc"],
)

clang_format_test(
    name = "clangformat",
    size = "small",
    srcs = glob([
        "src/*.cpp",
        "include/**/*.hpp",
        "test/**/*.cpp",
        "test/**/*.hpp",
    ]),
)

#TODO: use targets in //protobuf:... instead of the following
protobuf_cpp(
    name = "protobuf",
    src = "//protobuf:krpc.proto",
    include = "krpc/krpc.pb.hpp",
    header = "include/krpc/krpc.pb.hpp",
    source = "src/krpc.pb.cpp",
)
