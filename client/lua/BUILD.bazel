load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("//:config.bzl", "lua_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:lua.bzl", "lua_binary", "lua_library", "lua_test")
load("//tools/build:pkg.bzl", "pkg_zip")

exports_files(["CHANGELOG.md"])

# The client's own modules, laid out where require expects to find them. The schema is
# generated, and is the one module whose source path is not already its module path.
lua_library(
    name = "modules",
    srcs = glob(["krpc/**/*.lua"]) + ["//protobuf:lua"],
    path_map = {
        "client/lua/": "",
        "protobuf/KRPC.lua": "krpc/schema/KRPC.lua",
    },
)

lua_deps = [
    ":modules",
    "//tools/build/lua:luasocket",
    "//tools/build/lua:penlight",
    "//tools/build/lua:protobuf",
]

pkg_zip(
    name = "lua",
    out = "krpc-lua-%s.zip" % version,
    files = [
        ":rockspec",
        ":src",
    ],
    path_map = {
        "client/lua/": "",
    },
    visibility = ["//visibility:public"],
)

expand_template(
    name = "rockspec",
    out = "krpc-" + lua_version + "-0.rockspec",
    substitutions = {
        "%LUA_VERSION%": lua_version,
        "%VERSION%": version,
    },
    template = "rockspec.tmpl",
)

pkg_zip(
    name = "src",
    out = "krpc-%s.zip" % version,
    files = glob(["krpc/**/*.lua"]) + [
        "CHANGELOG.md",
        "LICENSE",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:version",
        "//protobuf:lua",
    ],
    path_map = {
        "COPYING": "krpc-%s/COPYING" % version,
        "COPYING.LESSER": "krpc-%s/COPYING.LESSER" % version,
        "VERSION.txt": "krpc-%s/VERSION.txt" % version,
        "client/lua/CHANGELOG.md": "krpc-%s/CHANGELOG.md" % version,
        "client/lua/LICENSE": "krpc-%s/LICENSE" % version,
        "client/": "krpc-%s/" % version,
        "protobuf/KRPC.lua": "krpc-%s/lua/krpc/schema/KRPC.lua" % version,
    },
)

test_suite(
    name = "test",
    tests = [
        ":client-localsocket",
        ":client-tcpip",
        ":communication-localsocket",
        ":communication-tcpip",
        ":unit",
    ],
)

# What the client does regardless of the transport it talks over: encoding and decoding
# values and the types they are carried as. It needs no server, so it runs on its own
# rather than under the harness that starts one.
lua_test(
    name = "unit",
    size = "small",
    main = "krpc/test/unit.lua",
    deps = lua_deps,
)

# The transport, one test each. Both run against a server the test listens on itself, so
# neither needs a kRPC server.
lua_test(
    name = "communication-tcpip",
    size = "small",
    main = "krpc/test/connection_tcpip.lua",
    tags = ["requires-network"],
    deps = lua_deps,
)

lua_test(
    name = "communication-localsocket",
    size = "small",
    main = "krpc/test/connection_localsocket.lua",
    deps = lua_deps,
)

# The client end to end against a TestServer, once per transport it can reach one over.
client_test(
    name = "client-tcpip",
    size = "small",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":luatest",
)

client_test(
    name = "client-localsocket",
    size = "small",
    server_executable = "//tools/TestServer",
    server_type = "localsocket",
    test_executable = ":luatest",
)

# The benchmark program, run by //tools/benchmarks:lua. Not a test: it measures. The
# script is not part of the client, so it is not in the module tree the client is.
lua_binary(
    name = "benchmark",
    main = "benchmark.lua",
    visibility = ["//tools/benchmarks:__pkg__"],
    deps = lua_deps,
)

lua_test(
    name = "luatest",
    size = "small",
    main = "krpc/test/client.lua",
    tags = ["requires-network"],
    deps = lua_deps,
)
