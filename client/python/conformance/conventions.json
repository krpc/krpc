{
  "remote_error": "krpc.error.RemoteError",
  "server_error": "krpc.error.ServerError",
  "native_types": {
    "System.InvalidOperationException": "RuntimeError",
    "System.ArgumentException": "ValueError",
    "System.ArgumentNullException": "ValueError",
    "System.ArgumentOutOfRangeException": "ValueError",
    "System.NullReferenceException": "TypeError",
    "System.Collections.Generic.KeyNotFoundException": "KeyError",
    "System.IndexOutOfRangeException": "IndexError",
    "System.DivideByZeroException": "ZeroDivisionError",
    "System.NotSupportedException": "NotImplementedError",
    "System.TimeoutException": "TimeoutError",
    "System.OverflowException": "OverflowError"
  },
  "naming": {
    "case": "snake",
    "accessors": false,
    "exceptions": true,
    "service_escapes": [
      "add_event",
      "add_stream",
      "add_stream_update_callback",
      "and",
      "as",
      "assert",
      "async",
      "await",
      "break",
      "class",
      "close",
      "compile",
      "continue",
      "def",
      "del",
      "elif",
      "else",
      "except",
      "finally",
      "for",
      "from",
      "get_call",
      "get_call_template",
      "global",
      "if",
      "import",
      "in",
      "is",
      "lambda",
      "nonlocal",
      "not",
      "or",
      "pass",
      "raise",
      "remove_stream_update_callback",
      "return",
      "run",
      "stream",
      "stream_update_condition",
      "try",
      "wait_for_stream_update",
      "while",
      "with",
      "yield"
    ],
    "type_escapes": [
      "{service}Connection",
      "False",
      "None",
      "True"
    ]
  }
}
