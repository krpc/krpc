load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//:config.bzl", "python_version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:python.bzl", "py_autodoc_test", "py_pyright_test", "py_ruff_test", "py_test", "py_wheel")
load("//tools/krpctools:clientgen.bzl", "clientgen_python_bundle", "clientgen_services")
load("//tools/krpctools:services.bzl", "SERVICES")

exports_files([
    "CHANGELOG.md",
    "conformance/conventions.json",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

# The modules of a game's services go in the package of the game, as krpc-ksp will ship them
services = clientgen_services(
    "python",
    outs = {
        s.name: "krpc/%s/%s.py" % (
            s.game,
            s.name.lower(),
        )
        for s in SERVICES
        if s.game
    },
)

# The krpc package as an importable python library, for use by other python
# targets in this workspace (the wheel below is what is released)
py_library(
    name = "krpc_lib",
    srcs = services + [
        ":services-ksp",
        ":services-testservice",
    ],
    visibility = ["//visibility:public"],
    deps = [":krpc_base_lib"],
)

# The krpc package without the generated service modules; clientgen (which
# generates those modules) depends on this, so this must not depend on
# clientgen's output
py_library(
    name = "krpc_base_lib",
    srcs = glob(["krpc/**/*.py"]) + [
        ":krpc-version-py",
        ":schema-py",
    ],
    # The type stub for the generated protobuf module, so type checkers see
    # the message classes (the module itself builds them dynamically)
    data = [":schema-pyi"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = ["@krpc_pypi//protobuf"],
)

genrule(
    name = "schema-py",
    srcs = ["//protobuf:python"],
    outs = ["krpc/schema/KRPC_pb2.py"],
    cmd = "for f in $(execpaths //protobuf:python); do case $$f in *KRPC_pb2.py) cp $$f $@;; esac; done",
)

genrule(
    name = "schema-pyi",
    srcs = ["//protobuf:python"],
    outs = ["krpc/schema/KRPC_pb2.pyi"],
    cmd = "for f in $(execpaths //protobuf:python); do case $$f in *KRPC_pb2.pyi) cp $$f $@;; esac; done",
)

clientgen_python_bundle(
    name = "services-ksp",
    out = "krpc/ksp/__init__.py",
    game = "ksp",
    template = "ksp_init.py.tmpl",
)

genrule(
    name = "krpc-version-py",
    srcs = ["//:python_version"],
    outs = ["krpc/version.py"],
    cmd = 'cp "$<" "$@"',
)

py_wheel(
    name = "python",
    out = "krpc-%s-py3-none-any.whl" % python_version,
    files = [
        "LICENSE",
        "README.md",
        "pyproject.toml",
        ":services-ksp",
        ":services-testservice",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
        "//protobuf:python",
        "//tools/build/protobuf:LICENSE.Google.Protobuf",
    ] + services + glob(["krpc/**/*"]),
    path_map = {
        "version.py": "krpc/version.py",
        "client/python/": "",
        "protobuf/": "krpc/schema/",
        "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.protobuf",
    },
)

# The tests that need no server, and those that run against one. Splitting them keeps the
# ones that are the same whatever carries a call from being run once per transport.
unit_tests = [
    "krpc/test/test_declarations.py",
    "krpc/test/test_definitions.py",
    "krpc/test/test_docmath.py",
    "krpc/test/test_expressionutils.py",
    "krpc/test/test_limits.py",
    "krpc/test/test_service_definitions.py",
    "krpc/test/test_session.py",
    "krpc/test/test_types.py",
]

client_tests = [
    "krpc/test/test_connection.py",
    "krpc/test/test_declarations_drift.py",
    "krpc/test/test_documentation.py",
    "krpc/test/test_expressiontree.py",
    "krpc/test/test_function.py",
    "krpc/test/test_functioncompiler.py",
    "krpc/test/test_stream.py",
]

test_suite(
    name = "test",
    tests = [
        ":autodoc",
        ":client-tcpip",
        ":conformance",
        ":lint",
        ":unit",
    ],
)

deps = ["@krpc_pypi//protobuf"]

# What the client does without a server: the types values are carried as, building services
# from their definitions, and reassembling a message out of the blocks a socket hands over.
py_test(
    name = "unit",
    size = "small",
    src = ":python",
    tests = unit_tests,
    deps = deps,
)

# The client's own API against a TestServer. The conformance tests cover each transport, so
# this runs over one.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":clienttest",
)

py_test(
    name = "clienttest",
    size = "small",
    src = ":python",
    tags = ["requires-network"],
    tests = client_tests,
    deps = deps,
)

# The documentation of the client, which its users read through sphinx
py_autodoc_test(
    name = "autodoc",
    size = "medium",
    exclude = ["krpc.test"],
    package = "krpc",
    deps = [":krpc_lib"],
)

# The conformance tests, driving the client through its testee
py_binary(
    name = "conformance-testee",
    srcs = ["conformance/testee.py"],
    main = "conformance/testee.py",
    visibility = ["//tools/krpctools:__pkg__"],
    deps = [
        ":krpc_lib",
        "//client/conformance:testee_py",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    conventions = "conformance/conventions.json",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "error-types",
        "dynamic",
        "definitions",
        "declarations",
        "defaults",
        "named-arguments",
        "streams",
        "events",
        "functions",
        "connections",
        "concurrency",
        "callbacks",
        "conditions",
        "ordering",
        "races",
    ],
    protocols = [
        "tcpip",
        "localsocket",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "conformance/*.py",
        "krpc/**/*.py",
    ]) + [":services-ksp"],
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "conformance/*.py",
        "krpc/**/*.py",
    ]) + services + [
        ":services-ksp",
        ":services-testservice",
    ],
    deps = [
        ":krpc_lib",
        "//client/conformance:testee_py",
    ],
)
