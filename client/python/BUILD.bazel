load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//:config.bzl", "python_version", "version")
load("//tools/build:client_test.bzl", "client_test")
load("//tools/build:conformance.bzl", "conformance_test")
load("//tools/build:python.bzl", "py_autodoc_test", "py_pyright_test", "py_ruff_test", "py_sdist", "py_test")
load("//tools/krpctools:clientgen.bzl", "clientgen_python_init", "clientgen_services")

exports_files([
    "CHANGELOG.md",
    "conformance/conventions.json",
    "conformance/expected-failures.txt",
    "conformance/unsupported.txt",
])

services = clientgen_services("python")

# The krpc package as an importable python library, for use by other python
# targets in this workspace (the sdists below are what is released)
py_library(
    name = "krpc_lib",
    srcs = services + [":services-testservice"],
    visibility = ["//visibility:public"],
    deps = [":krpc_base_lib"],
)

# The krpc package without the generated service modules; clientgen (which
# generates those modules) depends on this, so this must not depend on
# clientgen's output
py_library(
    name = "krpc_base_lib",
    srcs = glob(["krpc/**/*.py"]) + [
        ":krpc-version-py",
        ":schema-py",
        ":services-init",
    ],
    # The type stub for the generated protobuf module, so type checkers see
    # the message classes (the module itself builds them dynamically)
    data = [":schema-pyi"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = ["@krpc_pypi//protobuf"],
)

genrule(
    name = "schema-py",
    srcs = ["//protobuf:python"],
    outs = ["krpc/schema/KRPC_pb2.py"],
    cmd = "for f in $(execpaths //protobuf:python); do case $$f in *KRPC_pb2.py) cp $$f $@;; esac; done",
)

genrule(
    name = "schema-pyi",
    srcs = ["//protobuf:python"],
    outs = ["krpc/schema/KRPC_pb2.pyi"],
    cmd = "for f in $(execpaths //protobuf:python); do case $$f in *KRPC_pb2.pyi) cp $$f $@;; esac; done",
)

clientgen_python_init(
    name = "services-init",
    out = "krpc/services/__init__.py",
    template = "services_init.py.tmpl",
)

genrule(
    name = "krpc-version-py",
    srcs = ["//:python_version"],
    outs = ["krpc/version.py"],
    cmd = 'cp "$<" "$@"',
)

# Needed as clientgen depends on these files
genrule(
    name = "python_base",
    srcs = [":python-without-services"],
    outs = ["krpc-python-base-%s.tar.gz" % version],
    cmd = 'cp "$<" "$@"',
    output_to_bindir = True,
    visibility = ["//visibility:public"],
)

py_sdist(
    name = "python-without-services",
    out = "krpc-base-%s.tar.gz" % version,
    files = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "pyproject.toml",
        ":services-init",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
        "//:version",
        "//protobuf:python",
        "//tools/build/protobuf:LICENSE.Google.Protobuf",
    ] + glob(["krpc/**/*"]),
    path_map = {
        "version.py": "krpc/version.py",
        "client/python/": "",
        "protobuf/": "krpc/schema/",
        "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.protobuf",
    },
)

genrule(
    name = "python",
    srcs = [":python-pypi"],
    outs = ["krpc-python-%s.tar.gz" % version],
    cmd = 'cp "$<" "$@"',
    output_to_bindir = True,
    visibility = ["//visibility:public"],
)

py_sdist(
    name = "python-pypi",
    out = "krpc-%s.tar.gz" % version,
    files = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "pyproject.toml",
        ":services-init",
        ":services-testservice",
        "//:COPYING",
        "//:COPYING.LESSER",
        "//:python_version",
        "//:version",
        "//protobuf:python",
        "//tools/build/protobuf:LICENSE.Google.Protobuf",
    ] + services + glob(["krpc/**/*"]),
    path_map = {
        "version.py": "krpc/version.py",
        "client/python/": "",
        "protobuf/": "krpc/schema/",
        "tools/build/protobuf/LICENSE.Google.Protobuf": "LICENSE.protobuf",
    },
)

# The tests that need no server, and those that run against one. Splitting them keeps the
# ones that are the same whatever carries a call from being run once per transport.
unit_tests = [
    "krpc/test/test_definitions.py",
    "krpc/test/test_docmath.py",
    "krpc/test/test_expressionutils.py",
    "krpc/test/test_limits.py",
    "krpc/test/test_service_definitions.py",
    "krpc/test/test_session.py",
    "krpc/test/test_types.py",
]

client_tests = [
    "krpc/test/test_client.py",
    "krpc/test/test_documentation.py",
    "krpc/test/test_expressiontree.py",
    "krpc/test/test_function.py",
    "krpc/test/test_functioncompiler.py",
    "krpc/test/test_stream.py",
]

test_suite(
    name = "test",
    tests = [
        ":autodoc",
        ":client-base",
        ":client-tcpip",
        ":conformance",
        ":conformance-base",
        ":lint",
        ":unit",
    ],
)

deps = ["@krpc_pypi//protobuf"]

# What the client does without a server: the types values are carried as, building services
# from their definitions, and reassembling a message out of the blocks a socket hands over.
py_test(
    name = "unit",
    size = "small",
    src = ":python",
    pkg = "krpc-" + python_version,
    tests = unit_tests,
    deps = deps,
)

# The client's own API against a TestServer. The conformance tests cover each transport, so
# this runs over one.
client_test(
    name = "client-tcpip",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":clienttest",
)

# And again against the sdist built without the pre-generated service stubs, so that the
# services generated at runtime are covered as well.
client_test(
    name = "client-base",
    size = "medium",
    server_executable = "//tools/TestServer",
    tags = ["requires-network"],
    test_executable = ":clienttest_base",
)

py_test(
    name = "clienttest",
    size = "small",
    src = ":python",
    pkg = "krpc-" + python_version,
    tags = ["requires-network"],
    tests = client_tests,
    deps = deps,
)

py_test(
    name = "clienttest_base",
    size = "small",
    src = ":python_base",
    pkg = "krpc-" + python_version,
    tags = ["requires-network"],
    tests = client_tests,
    deps = deps,
)

# The documentation of the client, which its users read through sphinx
py_autodoc_test(
    name = "autodoc",
    size = "medium",
    exclude = ["krpc.test"],
    package = "krpc",
    deps = [":krpc_lib"],
)

# The conformance tests, driving the client through its testee
py_binary(
    name = "conformance-testee",
    srcs = ["conformance/testee.py"],
    main = "conformance/testee.py",
    visibility = ["//tools/krpctools:__pkg__"],
    deps = [
        ":krpc_lib",
        "//client/conformance:testee_py",
    ],
)

conformance_test(
    name = "conformance",
    size = "medium",
    conventions = "conformance/conventions.json",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "error-types",
        "dynamic",
        "defaults",
        "named-arguments",
        "streams",
        "events",
        "functions",
        "connections",
        "threads",
        "callbacks",
        "conditions",
        "ordering",
        "races",
    ],
    protocols = [
        "tcpip",
        "localsocket",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee",
    unsupported = "conformance/unsupported.txt",
)

# And again without the generated service modules, so the services are built from the
# server's definitions at run time
py_binary(
    name = "conformance-testee-base",
    srcs = ["conformance/testee.py"],
    main = "conformance/testee.py",
    deps = [
        ":krpc_base_lib",
        "//client/conformance:testee_py",
    ],
)

conformance_test(
    name = "conformance-base",
    size = "medium",
    conventions = "conformance/conventions.json",
    expected_failures = "conformance/expected-failures.txt",
    profiles = [
        "core",
        "error-types",
        "dynamic",
        "defaults",
        "named-arguments",
        "streams",
        "events",
        "functions",
        "connections",
        "threads",
        "callbacks",
        "conditions",
        "ordering",
        "races",
    ],
    tags = ["requires-network"],
    testee = ":conformance-testee-base",
    unsupported = "conformance/unsupported.txt",
)

test_suite(
    name = "lint",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob([
        "conformance/*.py",
        "krpc/**/*.py",
    ]) + [":services-init"],
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob([
        "conformance/*.py",
        "krpc/**/*.py",
    ]) + [":services-init"],
    deps = [
        ":krpc_lib",
        "//client/conformance:testee_py",
    ],
)
