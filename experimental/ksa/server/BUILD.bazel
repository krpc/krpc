load("//:config.bzl", "author", "versions")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:csharp.bzl", "csharp_library")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

exports_files(["mod.toml"])

csharp_assembly_info(
    name = "AssemblyInfo",
    cls_compliant = False,
    copyright = author,
    description = "RPC server for Kitten Space Agency",
    title = "KRPC.KSA",
    version = versions["ksa"],
)

csharp_library(
    name = "KRPC.KSA",
    srcs = glob(["src/**/*.cs"]) + [":AssemblyInfo"],
    generate_documentation_file = True,
    target_frameworks = ["net10.0"],
    treat_warnings_as_errors = True,
    visibility = ["//experimental/ksa:__subpackages__"],
    warning_level = 4,
    deps = [
        "//core:KRPC.Core.net10",
        "//experimental/ksa/service/KSA:KRPC.KSA.Service",
        "@ksa//:Brutal",
        "@ksa//:KSA",
        "@ksa//:Tomlet",
        "@paket.main//google.protobuf",
        "@paket.main//lib.harmony",
        "@paket.main//starmap.api",
        "@paket.main//system.io.ports",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":pyright",
        ":ruff",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["test/*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["test/*.py"]),
    disable = ["reportAttributeAccessIssue"],
    python_version = "3.12",
    deps = [
        "//experimental/ksa/tools/game:ksatest",
        "//experimental/ksa/tools/grpc:grpc-python",
        "@krpc_pypi//grpcio",
        "@krpc_pypi//pytest",
    ],
)
