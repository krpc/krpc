<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>KRPC.KSA</AssemblyName>
    <RootNamespace>KRPC.KSA</RootNamespace>
    <!-- Loaded by StarMap into its own load context, which resolves dependencies from the deps.json -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/Addon.cs" />
    <Compile Include="src/ConfigurationFile.cs" />
    <Compile Include="src/UI/ConsoleWindow.cs" />
    <Compile Include="src/UI/EditServer.cs" />
    <Compile Include="src/UI/InfoWindow.cs" />
    <Compile Include="src/UI/MainWindow.cs" />
    <Compile Include="src/UI/MenuBar.cs" />
    <Compile Include="src/UI/PromptPopup.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped with StarMap, which loads them before any mod -->
    <PackageReference Include="StarMap.API" Version="0.3.6" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Tomlet">
      <HintPath>$(KSADir)Tomlet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="mod.toml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="settings.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
