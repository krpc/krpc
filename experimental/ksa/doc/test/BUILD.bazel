load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")
load("//tools/doc_examples:defs.bzl", "example_js_runner")

# The in-game tests of the documentation examples. The game runs them with
# bazel run //experimental/ksa/tools/game:test-ksa -- experimental/ksa/doc/test

test_suite(
    name = "test",
    tests = [
        ":coverage",
        ":pyright",
        ":ruff",
    ],
    visibility = ["//experimental/ksa/doc:__pkg__"],
)

# What the coverage test reads: the manifest, its types and the listing
py_library(
    name = "manifest",
    srcs = [
        "checks.py",
        "examples.py",
        "flights.py",
        "spec.py",
    ],
    data = ["unsupported.txt"],
    imports = ["../../../.."],
    deps = ["//tools/doc_examples"],
)

py_test(
    name = "coverage",
    size = "small",
    srcs = ["coverage_test.py"],
    data = ["//experimental/ksa/doc:scripts"],
    main = "coverage_test.py",
    deps = [":manifest"],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    disable = ["reportAttributeAccessIssue"],
    python_version = "3.12",
    deps = [
        "//experimental/ksa/tools/game:ksatest",
        "//tools/doc_examples",
        "@krpc_pypi//pytest",
    ],
)

# Runs a JavaScript example against the game's WebSockets server
example_js_runner(
    name = "run-example-js",
    data = ["//experimental/ksa/doc:scripts-js"],
    scripts = "experimental/ksa/doc/src/scripts",
)
