load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("//:config.bzl", "core_version")
load("//experimental/ksa/tools/build:mod.bzl", "ASPNETCORE_RIDS", "NATIVE_PORTS", "deps_json", "files_in")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")
load(":config.bzl", "client_version", "ksa_version", "mod_version", "starmap_version")

exports_files(["CHANGELOG.md"])

# The kRPC for KSA mod and release archives. The game assemblies come from @ksa, the KSA
# install at KSA_DIR.

# The versions of the NuGet packages in the mod folder, as locked in
# //tools/build/dotnet:paket.lock
protobuf_version = "3.36.2"

ports_version = "10.0.15"

aspnetcore_version = "10.0.13"

grpc_version = "2.71.0"

write_file(
    name = "deps-json",
    out = "KRPC.KSA.deps.json",
    content = [deps_json(mod_version, core_version, protobuf_version, ports_version)],
)

# Loaded by StarMap into its own load context, as a component
write_file(
    name = "runtimeconfig-json",
    out = "KRPC.KSA.runtimeconfig.json",
    content = [json.encode_indent(
        {
            "runtimeOptions": {
                "tfm": "net10.0",
                "rollForward": "LatestMinor",
                "framework": {
                    "name": "Microsoft.NETCore.App",
                    "version": "10.0.0",
                },
            },
        },
        indent = "  ",
    )],
)

pkg_files(
    name = "mod-root",
    srcs = [
        ":deps-json",
        ":runtimeconfig-json",
        "//core:KRPC.Core.net10",
        "//experimental/ksa/server:KRPC.KSA",
        "//experimental/ksa/server:mod.toml",
        "//experimental/ksa/service/KFS:KRPC.KSA.KFS",
        "//experimental/ksa/service/KSA:KRPC.KSA.Service",
        "@nuget.google.protobuf.v%s//:lib/net8.0/Google.Protobuf.dll" % protobuf_version,
        "@nuget.system.io.ports.v%s//:lib/net10.0/System.IO.Ports.dll" % ports_version,
    ],
    prefix = "kRPC",
    strip_prefix = strip_prefix.files_only(),
)

[
    pkg_files(
        name = "mod-ports-" + rid,
        srcs = ["@nuget.system.io.ports.v%s//:runtimes/%s/lib/net10.0/System.IO.Ports.dll" % (ports_version, rid)],
        prefix = "kRPC/runtimes/%s/lib/net10.0" % rid,
        strip_prefix = strip_prefix.files_only(),
    )
    for rid in [
        "unix",
        "win",
    ]
]

[
    pkg_files(
        name = "mod-ports-native-" + rid,
        srcs = ["@nuget.runtime.%s.runtime.native.system.io.ports.v%s//:runtimes/%s/native/%s" % (rid, ports_version, rid, library)],
        prefix = "kRPC/runtimes/%s/native" % rid,
        strip_prefix = strip_prefix.files_only(),
    )
    for rid, library in NATIVE_PORTS.items()
]

pkg_files(
    name = "mod-grpc",
    srcs = [
        "//experimental/ksa/server/grpc:KRPC.KSA.Grpc",
        "@nuget.grpc.aspnetcore.server.v%s//:lib/net9.0/Grpc.AspNetCore.Server.dll" % grpc_version,
        "@nuget.grpc.core.api.v%s//:lib/netstandard2.1/Grpc.Core.Api.dll" % grpc_version,
        "@nuget.grpc.net.common.v%s//:lib/net8.0/Grpc.Net.Common.dll" % grpc_version,
    ],
    prefix = "kRPC/grpc",
    strip_prefix = strip_prefix.files_only(),
)

# KSA ships no ASP.NET Core, which the gRPC server runs on. The mod carries the assemblies of
# its runtime pack for each platform, as they are compiled ahead of time for one platform each.
[
    files_in(
        name = "aspnetcore-" + rid,
        srcs = ["@nuget.microsoft.aspnetcore.app.runtime.%s.v%s//:files" % (rid, aspnetcore_version)],
        directory = "runtimes/%s/lib/net10.0" % rid,
    )
    for rid in ASPNETCORE_RIDS
]

[
    pkg_files(
        name = "mod-aspnetcore-" + rid,
        srcs = [":aspnetcore-" + rid],
        prefix = "kRPC/grpc/" + rid,
        strip_prefix = strip_prefix.files_only(),
    )
    for rid in ASPNETCORE_RIDS
]

mod_files = [
    ":mod-root",
    ":mod-ports-unix",
    ":mod-ports-win",
    ":mod-grpc",
] + [":mod-ports-native-" + rid for rid in NATIVE_PORTS] + [":mod-aspnetcore-" + rid for rid in ASPNETCORE_RIDS]

# The mod folder, kRPC/, as installed in the KSA mods folder. The mod writes its settings in
# the game's user folder on first run.
pkg_zip(
    name = "mod",
    srcs = mod_files,
    out = "kRPC-mod.zip",
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "mod-testing-files",
    srcs = ["//experimental/ksa/tools/TestingTools:KRPC.KSA.TestingTools"],
    prefix = "kRPC",
    strip_prefix = strip_prefix.files_only(),
)

# The mod folder for the tests, with the TestingTools service. The test harness installs the
# test settings.
pkg_zip(
    name = "mod-testing",
    srcs = mod_files + [":mod-testing-files"],
    out = "kRPC-mod-testing.zip",
    visibility = ["//visibility:public"],
)

licenses = [
    "LICENSE",
    "//experimental/ksa/tools/build/dotnet:LICENSE.AspNetCore",
    "//experimental/ksa/tools/build/dotnet:LICENSE.Grpc",
    "//experimental/ksa/tools/build/dotnet:LICENSE.System.IO.Ports",
    "//experimental/ksa/tools/build/dotnet:THIRD-PARTY-NOTICES.AspNetCore",
    "//:COPYING",
    "//:COPYING.LESSER",
    "//tools/build/protobuf:LICENSE.Google.Protobuf",
]

expand_template(
    name = "release-readme",
    out = "release-readme/README.txt",
    substitutions = {
        "@KRPC_VERSION@": client_version,
        "@KSA_VERSION@": ksa_version,
        "@STARMAP_VERSION@": starmap_version,
        "@VERSION@": mod_version,
    },
    template = "//experimental/ksa/tools/release:README.txt",
)

pkg_files(
    name = "release-root",
    srcs = licenses + [":release-readme"],
    strip_prefix = strip_prefix.files_only(),
)

# The mod folder carries the licenses too, as the Borea mod manager installs only that folder
pkg_files(
    name = "release-mod-licenses",
    srcs = licenses,
    prefix = "kRPC",
    strip_prefix = strip_prefix.files_only(),
)

pkg_filegroup(
    name = "release-stubs",
    srcs = [
        "//experimental/ksa/service/KFS:stub-files",
        "//experimental/ksa/service/KSA:readme-file",
        "//experimental/ksa/service/KSA:stub-files",
    ],
    prefix = "stubs",
)

# The release archive: the mod folder at the top, where Borea finds the one folder holding a
# mod.toml, the client stubs, the licenses and a readme
pkg_zip(
    name = "release",
    srcs = mod_files + [
        ":release-mod-licenses",
        ":release-root",
        ":release-stubs",
    ],
    out = "krpc-ksa-v%s.zip" % mod_version,
)

# The tests that need no game: bazel test //experimental/ksa:test. The in-game tests run with
# //experimental/ksa/tools/game:test-ksa.
test_suite(
    name = "test",
    tests = [
        ":pyright",
        ":ruff",
        "//experimental/ksa/doc:test",
        "//experimental/ksa/server:test",
        "//experimental/ksa/service/KFS:test",
        "//experimental/ksa/service/KSA:test",
        "//experimental/ksa/tools/game:test",
        "//experimental/ksa/tools/grpc:test",
        "//experimental/ksa/tools/release:test",
    ],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = ["conftest.py"],
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = ["conftest.py"],
    python_version = "3.12",
    deps = ["//tools/krpctools:krpctools_lib"],
)
