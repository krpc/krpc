load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/build:python.bzl", "py_pyright_test", "py_ruff_test")

package(default_visibility = ["//experimental/ksa:__subpackages__"])

# The gRPC .proto file of a service, from its service definitions
py_binary(
    name = "protogen",
    srcs = ["protogen.py"],
)

py_ruff_test(
    name = "ruff",
    size = "small",
    srcs = glob(["*.py"]),
)

py_pyright_test(
    name = "pyright",
    size = "medium",
    srcs = glob(["*.py"]),
    python_version = "3.12",
    deps = [
        "//client/python:krpc_base_lib",
        "//tools/krpctools:krpctools_lib",
    ],
)
