load("//:config.bzl", "assembly_version", "author")
load("//tools/build:assembly_info.bzl", "csharp_assembly_info")
load("//tools/build:csharp.bzl", "csharp_library", "csharp_nunit_test")
load("//tools/ServiceDefinitions:build.bzl", "service_definitions")

exports_files(["CHANGELOG.md"])

filegroup(
    name = "core",
    srcs = [
        ":KRPC.Core.net472",
        ":ServiceDefinitions",
        ":StdLibServiceDefinitions",
    ],
    visibility = ["//:__pkg__"],
)

test_suite(
    name = "test",
    tests = [
        ":test-KRPC.Core",
    ],
)

csharp_assembly_info(
    name = "AssemblyInfo",
    cls_compliant = False,
    copyright = author,
    description = "Core server functionality for kRPC",
    title = "KRPC.Core",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to //:csproj-deps so it can copy AssemblyInfo.cs to generated_deps
    ],
)

internals_visible_to = [
    "KRPC.Core.Test",
    "TestingTools",
    # TestServer exposes the expression tree printer as a test-only RPC
    "TestServer",
    "TestService",
    "DynamicProxyGenAssembly2",
    # The Benchmark service runs a call through Services, the server's own dispatch path
    "KRPC.Benchmark",
]

csharp_library(
    name = "KRPC.Core.net472",
    srcs = glob(["src/**/*.cs"]) + [
        ":AssemblyInfo",
        "//protobuf:csharp_unity",
    ],
    out = "KRPC.Core",
    internals_visible_to = internals_visible_to,
    target_frameworks = ["net472"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = [
        "//tools/build/ksp:Google.Protobuf",
        "//tools/build/ksp:KRPC.IO.Ports",
    ],
)

csharp_library(
    name = "KRPC.Core.net10",
    srcs = glob(["src/**/*.cs"]) + [
        ":AssemblyInfo",
        "//protobuf:csharp",
    ],
    out = "KRPC.Core",
    internals_visible_to = internals_visible_to,
    # CS1701: Google.Protobuf's net5.0 build references net5-era framework
    # assemblies; unification handles this at runtime (MSBuild suppresses
    # this warning by default)
    nowarn = ["CS1701"],
    target_frameworks = ["net10.0"],
    treat_warnings_as_errors = True,
    visibility = ["//visibility:public"],
    warning_level = 4,
    deps = [
        "@paket.main//google.protobuf",
        "@paket.main//system.io.ports",
    ],
)

service_definitions(
    name = "ServiceDefinitions",
    out = "KRPC.Core.json",
    assemblies = [":KRPC.Core.net10"],
    service = "KRPC",
    visibility = ["//visibility:public"],
)

# The XML documentation file of the net10.0 build, for packaging beside
# KRPC.Core.dll in published tools: the server and the ServiceDefinitions tool
# read API documentation from the XML file next to the assembly at runtime.
genrule(
    name = "KRPC.Core.net10-xmldoc",
    srcs = [":KRPC.Core.net10"],
    outs = ["xmldoc-net10/KRPC.Core.xml"],
    cmd = 'for f in $(SRCS); do case "$$f" in *.xml) cp "$$f" "$@";; esac; done',
    visibility = ["//tools/krpctools:__pkg__"],
)

service_definitions(
    name = "StdLibServiceDefinitions",
    out = "KRPC.StdLib.json",
    assemblies = [":KRPC.Core.net10"],
    service = "StdLib",
    visibility = ["//visibility:public"],
)

csharp_assembly_info(
    name = "TestAssemblyInfo",
    cls_compliant = False,
    copyright = author,
    title = "KRPC.Core.Test",
    version = assembly_version,
    visibility = [
        "//:__pkg__",  # Make visible to krpc-genfiles so it can copy AssemblyInfo.cs to zip
    ],
)

csharp_nunit_test(
    name = "test-KRPC.Core",
    size = "small",
    srcs = glob(["test/**/*.cs"]) + [":TestAssemblyInfo"],
    out = "KRPC.Core.Test",
    # CS1701: Google.Protobuf/Newtonsoft.Json/Moq reference net5/6-era framework
    # assemblies; unification handles this at runtime (MSBuild suppresses this
    # warning by default). Matches KRPC.Core.net10 above.
    nowarn = [
        "CS1591",
        "CS1685",
        "CS1701",
    ],
    target_frameworks = ["net10.0"],
    visibility = ["//:__pkg__"],
    deps = [
        ":KRPC.Core.net10",
        "@paket.main//google.protobuf",
        "@paket.main//moq",
        "@paket.main//newtonsoft.json",
        "@paket.main//system.io.ports",
    ],
)

# Sources for //:csproj-test, which checks them against the .csproj file lists.
filegroup(
    name = "csproj-srcs",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
    ]),
    visibility = ["//:__pkg__"],
)
